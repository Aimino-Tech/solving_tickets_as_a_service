{
  "name": "solving-tickets-as-a-service",
  "version": "0.1.0",
  "private": true,
  "description": "Label a GitHub issue. Our bot investigates, fixes, and opens a PR. Backed by OpenCode.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "stas-init": "./scripts/init.ts"
  },
  "scripts": {
    "init": "tsx scripts/init.ts",
    "setup": "bash scripts/setup.sh",
    "doctor": "bash scripts/doctor.sh",
    "dev": "tsx watch src/index.ts",
    "dev:api": "RUN_MODE=api tsx watch src/index.ts",
    "dev:worker": "RUN_MODE=worker tsx watch src/index.ts",
    "build": "tsc",
    "build:dashboard": "cd dashboard && npm run build",
    "build:all": "npm run build && npm run build:dashboard",
    "start": "node dist/index.js",
    "start:api": "RUN_MODE=api node dist/index.js",
    "start:worker": "RUN_MODE=worker node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "format": "biome check --write src/",
    "lint:ci": "biome ci src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "docker compose -f docker-compose.e2e.yml up -d redis rabbitmq && vitest run --config vitest.e2e.config.ts; docker compose -f docker-compose.e2e.yml down --remove-orphans -t 5",
    "test:e2e:watch": "docker compose -f docker-compose.e2e.yml up -d redis && vitest --config vitest.e2e.config.ts",
    "test:e2e:docker": "docker compose -f docker-compose.e2e.yml up --abort-on-container-exit",
    "smee": "tsx scripts/smee.ts",
    "docker:build": "docker build -t stas-bot .",
    "docker:run": "docker run -p 3000:3000 stas-bot",
    "plugin:dev": "cd plugin && npm run dev",
    "plugin:build": "cd plugin && npm run build",
    "stas:dev": "bash plugin/tools/stas-dev.sh",
    "stas:webhook": "bash plugin/tools/stas-webhook-test.sh",
    "stas:config": "bash plugin/tools/stas-config.sh",
    "stas:status": "bash plugin/tools/stas-status.sh",
    "workers:up": "docker compose up -d celery-worker celery-beat flower",
    "workers:down": "docker compose down celery-worker celery-beat flower",
    "workers:logs": "docker compose logs -f celery-worker celery-beat flower",
    "workers:dev": "celery -A workers.celery_app worker --loglevel=info --concurrency=2",
    "workers:beat": "celery -A workers.celery_app beat --loglevel=info",
    "workers:flower": "celery -A workers.celery_app flower --port=5555 --loglevel=info",
    "test:e2e:ci": "vitest run --config vitest.e2e.config.ts",
    "test:load:webhook": "k6 run tests/load/webhook-load-test.js",
    "test:load:db": "k6 run tests/load/db-connection-pool-test.js",
    "test:load:queue": "k6 run tests/load/queue-throughput-test.js",
    "test:load:mixed": "k6 run tests/load/mixed-workload-test.js",
    "test:load:all": "bash tests/load/load-test-runner.sh",
    "bench:ci": "npx tsx scripts/bench.ts --ci",
    "test:worker": "docker compose -f docker-compose.e2e.yml up -d redis rabbitmq && vitest run --config vitest.worker.config.ts; docker compose -f docker-compose.e2e.yml down --remove-orphans -t 5",
    "test:worker:watch": "vitest --config vitest.worker.config.ts",
    "supply-chain:sbom": "bash scripts/supply-chain.sh sbom",
    "supply-chain:audit-npm": "bash scripts/supply-chain.sh audit-npm",
    "supply-chain:audit-pip": "bash scripts/supply-chain.sh audit-pip",
    "supply-chain:verify-lock": "bash scripts/supply-chain.sh verify-lock",
    "supply-chain:scan-docker": "bash scripts/supply-chain.sh scan-docker",
    "supply-chain:all": "bash scripts/supply-chain.sh all",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:dry-run": "tsx src/db/migrate.ts --dry-run",
    "db:migrate:rollback": "tsx src/db/migrate.ts --rollback",
    "db:migrate:benchmark": "tsx src/db/migrate.ts --benchmark",
    "db:migrate:test": "tsx scripts/test-migrations.ts",
    "db:migrate:test:check": "tsx scripts/test-migrations.ts --check",
    "db:migrate:bench": "tsx scripts/bench-migrations.ts",
    "db:migrate:bench:ci": "tsx scripts/bench-migrations.ts --ci --json",
    "test:db-migrations": "vitest run src/__tests__/db/",
    "release:dry-run": "bash scripts/release-dry-run.sh"
  },
  "dependencies": {
    "@octokit/auth-app": "^7.1.0",
    "@octokit/rest": "^21.0.0",
    "@octokit/webhooks": "^13.4.0",
    "@sentry/node": "^8.0.0",
    "@slack/bolt": "^4.7.3",
    "amqplib": "^0.10.5",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.6",
    "dockerode": "^5.0.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.38.4",
    "e2b": "^2.19.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.4.0",
    "js-yaml": "^4.1.0",
    "openai": "^4.77.0",
    "pg": "^8.21.0",
    "pino": "^9.6.0",
    "stripe": "^22.2.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@sentry/types": "^8.55.2",
    "@types/amqplib": "^0.10.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.6",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "smee-client": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}

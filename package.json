{
  "name": "solving-tickets-as-a-service",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/github-client"
  ],
  "description": "Label a GitHub issue. Our bot investigates, fixes, and opens a PR. Backed by OpenCode.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "stas-init": "./scripts/init.ts",
    "stas": "./src/template/cli.ts",
    "stas-install-mcp": "./scripts/stas-install-mcp.js"
  },
  "scripts": {
    "init": "tsx scripts/init.ts",
    "dev": "tsx watch src/index.ts",
    "dev:api": "RUN_MODE=api tsx watch src/index.ts",
    "dev:worker": "RUN_MODE=worker tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:api": "RUN_MODE=api node dist/index.js",
    "start:worker": "RUN_MODE=worker node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:eslint": "eslint src/__tests__/ --max-warnings=0",
    "test:architecture": "vitest run src/__tests__/architecture.test.ts --reporter=verbose",
    "test:mutation": "stryker run",
    "format": "biome check --write src/",
    "lint:ci": "biome ci src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/__tests__/template/",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smee": "tsx scripts/smee.ts",
    "docker:build": "docker build -t stas-bot .",
    "docker:run": "docker run -p 3000:3000 stas-bot",
    "plugin:dev": "cd plugin && npm run dev",
    "plugin:build": "cd plugin && npm run build",
    "stas:dev": "bash plugin/tools/stas-dev.sh",
    "stas:webhook": "bash plugin/tools/stas-webhook-test.sh",
    "stas:config": "bash plugin/tools/stas-config.sh",
    "stas:status": "bash plugin/tools/stas-status.sh",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:rollback": "tsx src/db/migrate.ts --rollback",
    "db:seed": "tsx src/db/seed.ts",
    "db:migrate:benchmark": "tsx src/db/migrate.ts --benchmark",
    "db:migrate:test": "tsx scripts/test-migrations.ts",
    "db:migrate:test:check": "tsx scripts/test-migrations.ts --check",
    "db:migrate:bench": "tsx scripts/bench-migrations.ts",
    "db:migrate:bench:ci": "tsx scripts/bench-migrations.ts --ci --json",
    "test:db-migrations": "vitest run src/__tests__/db/",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "knip": "knip --no-progress",
    "ts-prune": "ts-prune",
    "ghostcheck": "acv check src/",
    "trace-check": "npx trace-check",
    "anti-hallucination": "anti-hallucination index src/ && anti-hallucination report src/",
    "vibecop": "npx vibecop scan src/",
    "gitleaks": "gitleaks detect --source . -v 2>/dev/null || echo 'gitleaks not installed - install via: brew install gitleaks'",
    "quality-gates": "bash scripts/quality-gates.sh",
    "quality-gates:changed": "bash scripts/quality-gates.sh --changed-only",
    "leave-it-cleaner": "bash scripts/leave-it-cleaner.sh",
    "leave-it-cleaner:lsp": "bash scripts/leave-it-cleaner.sh --skip-tests",
    "leave-it-cleaner:tests": "bash scripts/leave-it-cleaner.sh --skip-lsp",
    "leave-it-cleaner:json": "bash scripts/leave-it-cleaner.sh --json",
    "release:dry-run": "bash scripts/release-dry-run.sh",
    "coverage-enforce": "bash scripts/coverage-enforce.sh",
    "coverage-enforce:mutation": "bash scripts/coverage-enforce.sh --mutation",
    "coverage-enforce:changed": "bash scripts/coverage-enforce.sh --changed",
    "anti-liar-gate": "tsx src/agent/antiLiarGate.ts",
    "install-mcp": "bash scripts/install-mcp.sh",
    "install-mcp:node": "node scripts/stas-install-mcp.js",
    "stas": "tsx src/template/cli.ts",
    "stas:validate": "tsx src/template/cli.ts template validate",
    "stas:dry-run": "tsx src/template/cli.ts template dry-run",
    "stas:install-hook": "tsx src/template/cli.ts install-hook"
  },
  "dependencies": {
    "@linear/sdk": "^87.0.0",
    "@octokit/auth-app": "^7.1.0",
    "@octokit/rest": "^21.0.0",
    "@octokit/webhooks": "^13.4.0",
    "@sentry/node": "^8.0.0",
    "@slack/bolt": "^4.7.3",
    "amqplib": "^2.0.1",
    "better-sqlite3": "11.10.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "e2b": "^2.19.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "graphlib": "^2.1.8",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "js-yaml": "5.2.1",
    "node-fetch": "^3.3.2",
    "parquetjs": "^0.11.2",
    "pg": "^8.21.0",
    "pino": "^9.6.0",
    "pixelmatch": "^7.2.0",
    "stripe": "^22.2.2",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@playwright/test": "^1.52.0",
    "@sentry/types": "^8.55.2",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.0",
    "@types/graphlib": "^2.1.12",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "anti-hallucination-mcp": "^0.14.0",
    "dockerode": "^5.0.1",
    "ghostcheck": "^0.1.0",
    "graphlib": "^2.1.8",
    "knip": "^6.20.0",
    "pino-pretty": "^13.1.3",
    "smee-client": "^5.0.0",
    "trace-core": "^0.7.0",
    "ts-prune": "^0.10.3",
    "tsarch": "^5.4.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.1",
    "vibecop": "^0.4.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  },
  "keywords": [
    "agentskills",
    "claude-plugin",
    "codex",
    "cursor",
    "mcp",
    "opencode-skill",
    "skill"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}

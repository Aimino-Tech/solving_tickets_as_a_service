{
  "name": "solving-tickets-as-a-service",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/github-client",
    "packages/syntaro-mcp",
    "packages/syntaro-cli"
  ],
  "description": "Label a GitHub issue. Our bot investigates, fixes, and opens a PR. Backed by OpenCode.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "syntaro-init": "./scripts/init.ts",
    "syntaro": "./src/template/cli.ts",
    "syntaro-install-mcp": "./scripts/syntaro-install-mcp.js"
  },
  "scripts": {
    "init": "tsx scripts/init.ts",
    "bb:oauth-check": "node scripts/bitbucket-oauth-check.mjs",
    "dev": "tsx watch src/index.ts",
    "dev:api": "RUN_MODE=api tsx watch src/index.ts",
    "dev:worker": "RUN_MODE=worker tsx watch src/index.ts",
    "build": "npm run build -w @syntaro/github-client && tsc",
    "start": "node dist/src/index.js",
    "start:api": "RUN_MODE=api node dist/src/index.js",
    "start:worker": "RUN_MODE=worker node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lighthouse:sweep": "bash scripts/lighthouse-sweep.sh",
    "lint": "biome check src/",
    "lint:eslint": "eslint src/__tests__/ --max-warnings=0",
    "test:architecture": "vitest run src/__tests__/architecture.test.ts --reporter=verbose",
    "test:mutation": "stryker run",
    "format": "biome check --write src/",
    "lint:ci": "biome ci src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/__tests__/template/",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smee": "tsx scripts/smee.ts",
    "docker:build": "docker build -t syntaro-bot .",
    "docker:run": "docker run -p 3000:3000 syntaro-bot",
    "plugin:dev": "cd plugin && npm run dev",
    "plugin:build": "cd plugin && npm run build",
    "syntaro:dev": "bash plugin/tools/syntaro-dev.sh",
    "syntaro:webhook": "bash plugin/tools/syntaro-webhook-test.sh",
    "syntaro:config": "bash plugin/tools/syntaro-config.sh",
    "syntaro:status": "bash plugin/tools/syntaro-status.sh",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:rollback": "tsx src/db/migrate.ts --rollback",
    "db:seed": "tsx src/db/seed.ts",
    "db:migrate:benchmark": "tsx src/db/migrate.ts --benchmark",
    "db:migrate:test": "tsx scripts/test-migrations.ts",
    "db:migrate:test:check": "tsx scripts/test-migrations.ts --check",
    "db:migrate:bench": "tsx scripts/bench-migrations.ts",
    "db:migrate:bench:ci": "tsx scripts/bench-migrations.ts --ci --json",
    "test:db-migrations": "vitest run src/__tests__/db/",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "knip": "knip --no-progress",
    "ts-prune": "ts-prune",
    "ghostcheck": "acv check src/",
    "trace-check": "npx trace-check",
    "anti-hallucination": "anti-hallucination index src/ && anti-hallucination report src/",
    "vibecop": "npx vibecop scan src/",
    "gitleaks": "gitleaks detect --source . -v 2>/dev/null || echo 'gitleaks not installed - install via: brew install gitleaks'",
    "quality-gates": "bash scripts/quality-gates.sh",
    "quality-gates:changed": "bash scripts/quality-gates.sh --changed-only",
    "leave-it-cleaner": "bash scripts/leave-it-cleaner.sh",
    "leave-it-cleaner:lsp": "bash scripts/leave-it-cleaner.sh --skip-tests",
    "leave-it-cleaner:tests": "bash scripts/leave-it-cleaner.sh --skip-lsp",
    "leave-it-cleaner:json": "bash scripts/leave-it-cleaner.sh --json",
    "release:dry-run": "bash scripts/release-dry-run.sh",
    "coverage-enforce": "bash scripts/coverage-enforce.sh",
    "coverage-enforce:mutation": "bash scripts/coverage-enforce.sh --mutation",
    "coverage-enforce:changed": "bash scripts/coverage-enforce.sh --changed",
    "anti-liar-gate": "tsx src/agent/antiLiarGate.ts",
    "install-mcp": "bash scripts/install-mcp.sh",
    "install-mcp:node": "node scripts/syntaro-install-mcp.js",
    "syntaro": "tsx src/template/cli.ts",
    "syntaro:validate": "tsx src/template/cli.ts template validate",
    "syntaro:dry-run": "tsx src/template/cli.ts template dry-run",
    "syntaro:install-hook": "tsx src/template/cli.ts install-hook",
    "test:e2e:smoke": "bash scripts/run-e2e-smoke-tests.sh",
    "test:e2e:smoke:verbose": "bash scripts/run-e2e-smoke-tests.sh --verbose",
    "test:e2e:smoke:list": "bash scripts/run-e2e-smoke-tests.sh --list",
    "test:launch-readiness": "vitest run --config vitest.launch.config.ts",
    "eval:continuity": "tsx eval/continuity/continuity.eval.ts",
    "eval:rehydrate": "tsx eval/continuity/rehydrate.eval.ts",
    "test:smoke:happy": "vitest run tests/e2e/happy-path.test.ts --config vitest.e2e.config.ts",
    "test:smoke:error": "vitest run tests/e2e/error-handling-path.test.ts --config vitest.e2e.config.ts",
    "test:smoke:auth": "vitest run tests/e2e/auth-path.test.ts --config vitest.e2e.config.ts",
    "test:smoke:dlq": "vitest run tests/e2e/dlq-path.test.ts --config vitest.e2e.config.ts",
    "test:smoke:health": "vitest run tests/e2e/health-check-path.test.ts --config vitest.e2e.config.ts",
    "test:automation": "npx playwright test --config tests/automation/playwright.config.ts",
    "test:automation:health": "npx playwright test tests/automation/tests/01-health --config tests/automation/playwright.config.ts",
    "test:automation:login": "npx playwright test tests/automation/tests/02-login --config tests/automation/playwright.config.ts",
    "test:automation:integration": "npx playwright test tests/automation/tests/06-integration --config tests/automation/playwright.config.ts",
    "test:automation:report": "npx playwright show-report tests/automation/reports/html",
    "test:automation:ui": "npx playwright test --ui --config tests/automation/playwright.config.ts",
    "test:automation:python": "cd tests/automation && python -m pytest -v",
    "test:automation:python:login": "cd tests/automation && python -m pytest test_login.py -v",
    "test:automation:python:api": "cd tests/automation && python -m pytest test_auth_api.py -v",
    "eval:conversations": "tsx eval/conversations/run.ts",
    "syntaro:quickstart": "tsx src/template/cli.ts quickstart",
    "eval:scorecard": "tsx eval/scorecard.ts"
  },
  "dependencies": {
    "@linear/sdk": "^87.0.0",
    "@octokit/auth-app": "^7.1.0",
    "@octokit/rest": "^21.0.0",
    "@octokit/webhooks": "^13.4.0",
    "@sentry/node": "^8.0.0",
    "@slack/bolt": "^4.7.3",
    "@supabase/supabase-js": "^2.110.9",
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "e2b": "^2.19.0",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.5.2",
    "graphlib": "^2.1.8",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "js-yaml": "5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^3.3.2",
    "parquetjs": "^0.11.2",
    "pg": "^8.21.0",
    "pino": "^9.6.0",
    "pixelmatch": "^7.2.0",
    "posthog-node": "^4.18.0",
    "stripe": "^22.2.2",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@playwright/test": "^1.52.0",
    "@sentry/types": "^8.55.2",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.0",
    "@types/graphlib": "^2.1.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "anti-hallucination-mcp": "^0.14.0",
    "dockerode": "^5.0.1",
    "ghostcheck": "^0.1.0",
    "graphlib": "^2.1.8",
    "knip": "^6.20.0",
    "pino-pretty": "^13.1.3",
    "smee-client": "^5.0.0",
    "trace-core": "^0.7.0",
    "ts-prune": "^0.10.3",
    "tsarch": "^5.4.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.1",
    "vibecop": "^0.4.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  },
  "keywords": [
    "agentskills",
    "claude-plugin",
    "codex",
    "cursor",
    "mcp",
    "opencode-skill",
    "skill"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@ast-grep/lang-python",
      "@swc/core",
      "cpu-features",
      "esbuild",
      "lzo",
      "protobufjs",
      "ssh2",
      "tree-sitter-go",
      "tree-sitter-python",
      "tree-sitter-rust"
    ]
  },
  "mcpName": "syntaro-agent-discovery"
}
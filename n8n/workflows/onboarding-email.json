{
  "name": "Onboarding Email — new signup → welcome + credits",
  "nodes": [
    {
      "id": "schedule-1",
      "name": "Every 1 Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300],
      "parameters": {
        "rule": {
          "interval": 1
        }
      }
    },
    {
      "id": "pg-fetch-new-users",
      "name": "Fetch New Signups",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [500, 300],
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $env.ONBOARDING_FETCH_QUERY || 'SELECT id, email, name, api_key, credits_balance, created_at FROM users WHERE welcomed = false AND email IS NOT NULL LIMIT 50' }}",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "{{ $env.N8N_POSTGRES_CREDENTIAL_ID }}",
          "name": "Postgres"
        }
      }
    },
    {
      "id": "if-has-users",
      "name": "Has New Signups?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [750, 300],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "has-users",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "larger"
              }
            }
          ]
        }
      }
    },
    {
      "id": "loop-users",
      "name": "Loop Through Users",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 2,
      "position": [1000, 300],
      "parameters": {
        "batchSize": 1
      }
    },
    {
      "id": "code-build-email",
      "name": "Build Welcome Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 300],
      "parameters": {
        "language": "javascript",
        "code": "const user = $input.first().json;\nconst docsUrl = $env.DOCS_URL || 'https://docs.syntaro.com';\nconst appUrl = $env.APP_URL || 'https://app.syntaro.com';\nconst creditAmount = user.credits_balance || 100;\n\nconst htmlBody = `\n<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <h1 style=\"color: #2563EB;\">Welcome to Syntaro!</h1>\n  <p>Hi ${user.name || user.email || 'there'},</p>\n  <p>Thanks for signing up! We're excited to have you on board.</p>\n\n  <h2 style=\"color: #374151;\">Your Account</h2>\n  <table style=\"width: 100%; border-collapse: collapse;\">\n    <tr><td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Email</strong></td><td style=\"padding: 8px; border: 1px solid #ddd;\">${user.email}</td></tr>\n    <tr><td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>API Key</strong></td><td style=\"padding: 8px; border: 1px solid #ddd; font-family: monospace;\">${user.api_key || 'Generated on first login'}</td></tr>\n    <tr><td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Credit Balance</strong></td><td style=\"padding: 8px; border: 1px solid #ddd;\">$${creditAmount.toFixed(2)}</td></tr>\n  </table>\n\n  <h2 style=\"color: #374151;\">Quick Start</h2>\n  <ol>\n    <li>Install our GitHub App: <a href=\"${appUrl}/install\">${appUrl}/install</a></li>\n    <li>Configure your first repository</li>\n    <li>We'll start solving tickets automatically!</li>\n  </ol>\n\n  <h2 style=\"color: #374151;\">Resources</h2>\n  <ul>\n    <li><a href=\"${docsUrl}\">Documentation</a></li>\n    <li><a href=\"${docsUrl}/api\">API Reference</a></li>\n    <li><a href=\"${docsUrl}/getting-started\">Getting Started Guide</a></li>\n  </ul>\n\n  <hr style=\"border: none; border-top: 1px solid #eee;\" />\n  <p style=\"color: #6B7280; font-size: 12px;\">\n    You have $${creditAmount.toFixed(2)} in free credits to get started.\n    Need help? Contact us at support@syntaro.com\n  </p>\n</div>`;\n\nconst textBody = `Welcome to Syntaro!\n\nHi ${user.name || user.email || 'there'},\n\nThanks for signing up!\n\nYour Account:\n- Email: ${user.email}\n- API Key: ${user.api_key || 'Generated on first login'}\n- Credits: $${creditAmount.toFixed(2)}\n\nQuick Start:\n1. Install our GitHub App: ${appUrl}/install\n2. Configure your first repository\n3. We'll start solving tickets!\n\nResources:\n- Documentation: ${docsUrl}\n- API Reference: ${docsUrl}/api\n- Getting Started: ${docsUrl}/getting-started\n\nYou have $${creditAmount.toFixed(2)} in free credits.\nNeed help? Contact us at support@syntaro.com`;\n\nreturn [{\n  json: {\n    email: user.email,\n    user_id: user.id,\n    subject: 'Welcome to Syntaro — You have $' + creditAmount.toFixed(2) + ' in credits!',\n    htmlBody: htmlBody,\n    textBody: textBody\n  }\n}];"
      }
    },
    {
      "id": "email-send",
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1500, 300],
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM || 'welcome@syntaro.com' }}",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "htmlBody": "={{ $json.htmlBody }}",
        "textBody": "={{ $json.textBody }}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "{{ $env.N8N_SMTP_CREDENTIAL_ID }}",
          "name": "SMTP"
        }
      }
    },
    {
      "id": "pg-mark-welcomed",
      "name": "Mark as Welcomed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1500, 500],
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ 'UPDATE users SET welcomed = true, welcomed_at = NOW() WHERE id = ' + $json.user_id }}",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "{{ $env.N8N_POSTGRES_CREDENTIAL_ID }}",
          "name": "Postgres"
        }
      }
    },
    {
      "id": "noop-done",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1750, 300],
      "parameters": {}
    }
  ],
  "connections": {
    "Every 1 Minute": {
      "main": [[{ "node": "Fetch New Signups", "type": "main", "index": 0 }]]
    },
    "Fetch New Signups": {
      "main": [[{ "node": "Has New Signups?", "type": "main", "index": 0 }]]
    },
    "Has New Signups?": {
      "main": [
        [{ "node": "Loop Through Users", "type": "main", "index": 0 }],
        []
      ]
    },
    "Loop Through Users": {
      "main": [[{ "node": "Build Welcome Email", "type": "main", "index": 0 }]]
    },
    "Build Welcome Email": {
      "main": [
        [{ "node": "Send Welcome Email", "type": "main", "index": 0 }, { "node": "Mark as Welcomed", "type": "main", "index": 0 }]
      ]
    },
    "Send Welcome Email": {
      "main": [[{ "node": "Done", "type": "main", "index": 0 }]]
    },
    "Mark as Welcomed": {
      "main": [[{ "node": "Loop Through Users", "type": "main", "index": 1 }]]
    },
    "Done": {
      "main": [[]]
    }
  }
}

{
  "name": "Stripe Billing Webhooks",
  "nodes": [
    {
      "id": "stripe-webhook",
      "name": "Stripe Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "stripe-billing",
        "options": {}
      }
    },
    {
      "id": "switch-event",
      "name": "Route by Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [500, 300],
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.type }}",
        "rules": [
          { "value": "checkout.session.completed", "output": 0 },
          { "value": "invoice.paid", "output": 1 },
          { "value": "invoice.payment_failed", "output": 2 },
          { "value": "customer.subscription.updated", "output": 3 },
          { "value": "customer.subscription.deleted", "output": 4 }
        ],
        "fallbackOutput": 5
      }
    },
    {
      "id": "call-stripe-process",
      "name": "Process in STAS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.STAS_API_URL }}/api/billing/stripe-event",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Authorization", "value": "={{ $env.STAS_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "options": {}
      }
    },
    {
      "id": "format-checkout",
      "name": "Alert: Purchase",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [750, 100],
      "parameters": {
        "values": {
          "string": [
            { "name": "channel", "value": "#syntaro-alerts" },
            { "name": "color", "value": "#2ECC71" },
            { "name": "title", "value": "Credit Purchase" },
            { "name": "text", "value": "={{ 'Credits purchased — customer ' + ($json.data?.object?.customer || 'unknown') + ' — ' + (($json.data?.object?.amount_total || 0) / 100).toFixed(2) + ' ' + ($json.data?.object?.currency || 'usd').toUpperCase() }}" }
          ]
        }
      }
    },
    {
      "id": "format-invoice-paid",
      "name": "Alert: Invoice Paid",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [750, 200],
      "parameters": {
        "values": {
          "string": [
            { "name": "channel", "value": "#syntaro-alerts" },
            { "name": "color", "value": "#3498DB" },
            { "name": "title", "value": "Invoice Paid" },
            { "name": "text", "value": "={{ 'Invoice ' + ($json.data?.object?.id || 'unknown') + ' paid — ' + (($json.data?.object?.amount_paid || 0) / 100).toFixed(2) + ' ' + ($json.data?.object?.currency || 'usd').toUpperCase() }}" }
          ]
        }
      }
    },
    {
      "id": "format-payment-failed",
      "name": "Alert: Payment Failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [750, 300],
      "parameters": {
        "values": {
          "string": [
            { "name": "channel", "value": "#syntaro-alerts" },
            { "name": "color", "value": "#E74C3C" },
            { "name": "title", "value": "Payment Failed" },
            { "name": "text", "value": "={{ 'Invoice ' + ($json.data?.object?.id || 'unknown') + ' payment failed after ' + ($json.data?.object?.attempt_count || 0) + ' attempt(s)' }}" }
          ]
        }
      }
    },
    {
      "id": "format-sub-updated",
      "name": "Alert: Subscription Updated",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [750, 400],
      "parameters": {
        "values": {
          "string": [
            { "name": "channel", "value": "#syntaro-alerts" },
            { "name": "color", "value": "#F39C12" },
            { "name": "title", "value": "Subscription Updated" },
            { "name": "text", "value": "={{ 'Subscription ' + ($json.data?.object?.id || 'unknown') + ' — plan: ' + ($json.data?.object?.items?.data?.[0]?.price?.nickname || 'unknown') + ' — status: ' + ($json.data?.object?.status || 'unknown') }}" }
          ]
        }
      }
    },
    {
      "id": "format-sub-deleted",
      "name": "Alert: Subscription Cancelled",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [750, 500],
      "parameters": {
        "values": {
          "string": [
            { "name": "channel", "value": "#syntaro-alerts" },
            { "name": "color", "value": "#95A5A6" },
            { "name": "title", "value": "Subscription Cancelled" },
            { "name": "text", "value": "={{ 'Subscription ' + ($json.data?.object?.id || 'unknown') + ' cancelled for customer ' + ($json.data?.object?.customer || 'unknown') }}" }
          ]
        }
      }
    },
    {
      "id": "format-unknown",
      "name": "Alert: Unknown Event",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [750, 600],
      "parameters": {
        "values": {
          "string": [
            { "name": "channel", "value": "#syntaro-alerts" },
            { "name": "color", "value": "#95A5A6" },
            { "name": "title", "value": "Unknown Stripe Event" },
            { "name": "text", "value": "={{ 'Unhandled Stripe event type: ' + ($json.type || 'unknown') }}" }
          ]
        }
      }
    },
    {
      "id": "slack-notification",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1000, 300],
      "parameters": {
        "channel": "={{ $json.channel }}",
        "text": "=",
        "attachments": "={{ [{\"color\": $json.color, \"title\": $json.title, \"text\": $json.text}] }}"
      }
    }
  ],
  "connections": {
    "Stripe Webhook": {
      "main": [[{ "node": "Route by Event Type", "type": "main", "index": 0 }]]
    },
    "Route by Event Type": {
      "main": [
        [{ "node": "Alert: Purchase", "type": "main", "index": 0 }],
        [{ "node": "Alert: Invoice Paid", "type": "main", "index": 0 }],
        [{ "node": "Alert: Payment Failed", "type": "main", "index": 0 }],
        [{ "node": "Alert: Subscription Updated", "type": "main", "index": 0 }],
        [{ "node": "Alert: Subscription Cancelled", "type": "main", "index": 0 }],
        [{ "node": "Alert: Unknown Event", "type": "main", "index": 0 }]
      ]
    },
    "Alert: Purchase": {
      "main": [[{ "node": "Process in STAS", "type": "main", "index": 0 }]]
    },
    "Alert: Invoice Paid": {
      "main": [[{ "node": "Process in STAS", "type": "main", "index": 0 }]]
    },
    "Alert: Payment Failed": {
      "main": [[{ "node": "Process in STAS", "type": "main", "index": 0 }]]
    },
    "Alert: Subscription Updated": {
      "main": [[{ "node": "Process in STAS", "type": "main", "index": 0 }]]
    },
    "Alert: Subscription Cancelled": {
      "main": [[{ "node": "Process in STAS", "type": "main", "index": 0 }]]
    },
    "Alert: Unknown Event": {
      "main": [[{ "node": "Process in STAS", "type": "main", "index": 0 }]]
    },
    "Process in STAS": {
      "main": [[{ "node": "Post to Slack", "type": "main", "index": 0 }]]
    }
  }
}

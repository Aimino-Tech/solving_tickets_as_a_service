{
  "name": "OS Notifications → Slack",
  "nodes": [
    {
      "id": "webhook-1",
      "name": "OS Notification Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "os-notification",
        "options": {}
      }
    },
    {
      "id": "switch-event",
      "name": "Route by Event",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [500, 300],
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.event }}",
        "rules": [
          { "value": "fix_started", "output": 0 },
          { "value": "pr_created", "output": 1 },
          { "value": "fix_failed", "output": 2 },
          { "value": "verification_failed", "output": 3 },
          { "value": "error", "output": 4 },
          { "value": "payment_failed", "output": 5 },
          { "value": "payment_recovered", "output": 6 }
        ],
        "fallbackOutput": 7
      }
    },
    {
      "id": "format-fix-started",
      "name": "Format: Fix Started",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [750, 100],
      "parameters": {
        "values": {
          "string": [
            { "name": "channel", "value": "={{ $json.channel || '#syntaro-notifications' }}" },
            { "name": "color", "value": "#3498DB" },
            { "name": "emoji", "value": ":mag:" },
            { "name": "title", "value": "Investigation Started" },
            { "name": "text", "value": "={{ $json.bot_name || 'SYNTARO' }} is investigating {{ '#' + $json.issue_number }} — {{ $json.issue_title }} in {{ $json.repo_owner + '/' + $json.repo_name }}" }
          ]
        }
      }
    },
    {
      "id": "format-pr-created",
      "name": "Format: PR Created",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [750, 180],
      "parameters": {
        "values": {
          "string": [
            { "name": "channel", "value": "={{ $json.channel || '#syntaro-notifications' }}" },
            { "name": "color", "value": "#2ECC71" },
            { "name": "emoji", "value": ":rocket:" },
            { "name": "title", "value": "PR Opened" },
            { "name": "text", "value": "={{ $json.bot_name || 'SYNTARO' }} opened a PR for {{ '#' + $json.issue_number }} — {{ $json.issue_title }} in {{ $json.repo_owner + '/' + $json.repo_name }}" },
            { "name": "pr_url", "value": "={{ $json.pr_url }}" }
          ]
        }
      }
    },
    {
      "id": "format-fix-failed",
      "name": "Format: Fix Failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [750, 260],
      "parameters": {
        "values": {
          "string": [
            { "name": "channel", "value": "={{ $json.channel || '#syntaro-notifications' }}" },
            { "name": "color", "value": "#E74C3C" },
            { "name": "emoji", "value": ":x:" },
            { "name": "title", "value": "Fix Failed" },
            { "name": "text", "value": "={{ $json.bot_name || 'SYNTARO' }} couldn't fix {{ '#' + $json.issue_number }} — {{ $json.issue_title }} in {{ $json.repo_owner + '/' + $json.repo_name }}" },
            { "name": "reason", "value": "={{ $json.reason || 'No reason provided' }}" }
          ]
        }
      }
    },
    {
      "id": "format-verification-failed",
      "name": "Format: Verification Failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [750, 340],
      "parameters": {
        "values": {
          "string": [
            { "name": "channel", "value": "={{ $json.channel || '#syntaro-notifications' }}" },
            { "name": "color", "value": "#F39C12" },
            { "name": "emoji", "value": ":warning:" },
            { "name": "title", "value": "Verification Failed" },
            { "name": "text", "value": "={{ $json.bot_name || 'SYNTARO' }} fix for {{ '#' + $json.issue_number }} — {{ $json.issue_title }} failed verification in {{ $json.repo_owner + '/' + $json.repo_name }}" },
            { "name": "reason", "value": "={{ $json.reason || 'No reason provided' }}" }
          ]
        }
      }
    },
    {
      "id": "format-error",
      "name": "Format: Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [750, 420],
      "parameters": {
        "values": {
          "string": [
            { "name": "channel", "value": "={{ $json.channel || '#syntaro-notifications' }}" },
            { "name": "color", "value": "#E74C3C" },
            { "name": "emoji", "value": ":fire:" },
            { "name": "title", "value": "Error" },
            { "name": "text", "value": "={{ $json.bot_name || 'SYNTARO' }} encountered an error on {{ '#' + $json.issue_number }} — {{ $json.issue_title }} in {{ $json.repo_owner + '/' + $json.repo_name }}" },
            { "name": "error_message", "value": "={{ $json.error_message || 'Unknown error' }}" }
          ]
        }
      }
    },
    {
      "id": "format-payment-failed",
      "name": "Format: Payment Failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [750, 500],
      "parameters": {
        "values": {
          "string": [
            { "name": "channel", "value": "={{ $json.channel || '#syntaro-billing' }}" },
            { "name": "color", "value": "#E74C3C" },
            { "name": "emoji", "value": ":credit_card:" },
            { "name": "title", "value": "Payment Failed" },
            { "name": "text", "value": "={{ $json.issue_title || 'Payment failed' }}" },
            { "name": "amount", "value": "={{ $json.metadata?.amount_cents ? '£' + ($json.metadata.amount_cents / 100).toFixed(2) : 'Unknown' }}" },
            { "name": "email", "value": "={{ $json.email || '' }}" },
            { "name": "reason", "value": "={{ $json.reason || 'No reason provided' }}" }
          ]
        }
      }
    },
    {
      "id": "format-payment-recovered",
      "name": "Format: Payment Recovered",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [750, 580],
      "parameters": {
        "values": {
          "string": [
            { "name": "channel", "value": "={{ $json.channel || '#syntaro-billing' }}" },
            { "name": "color", "value": "#2ECC71" },
            { "name": "emoji", "value": ":white_check_mark:" },
            { "name": "title", "value": "Payment Recovered" },
            { "name": "text", "value": "={{ $json.issue_title || 'Payment recovered' }}" },
            { "name": "amount", "value": "={{ $json.metadata?.amount_cents ? '£' + ($json.metadata.amount_cents / 100).toFixed(2) : 'Unknown' }}" },
            { "name": "email", "value": "={{ $json.email || '' }}" }
          ]
        }
      }
    },
    {
      "id": "format-unknown",
      "name": "Format: Unknown Event",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [750, 660],
      "parameters": {
        "values": {
          "string": [
            { "name": "channel", "value": "={{ $json.channel || '#syntaro-notifications' }}" },
            { "name": "color", "value": "#95A5A6" },
            { "name": "emoji", "value": ":grey_question:" },
            { "name": "title", "value": "Unknown Notification Event" },
            { "name": "text", "value": "={{ JSON.stringify($json) }}" }
          ]
        }
      }
    },
    {
      "id": "merge-1",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [1000, 300],
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition"
      }
    },
    {
      "id": "code-build-blocks",
      "name": "Build Slack Blocks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 300],
      "parameters": {
        "language": "javascript",
        "code": "const item = $input.first().json;\nconst blocks = [\n  {\n    type: 'header',\n    text: { type: 'plain_text', text: `${item.emoji || ''} ${item.title || 'Notification'}` }\n  },\n  {\n    type: 'section',\n    text: { type: 'mrkdwn', text: item.text || 'No details' }\n  }\n];\n\nif (item.reason) {\n  blocks.push({\n    type: 'section',\n    text: { type: 'mrkdwn', text: `*Reason:* ${item.reason}` }\n  });\n}\n\nif (item.error_message) {\n  blocks.push({\n    type: 'section',\n    text: { type: 'mrkdwn', text: `*Error:* ${item.error_message}` }\n  });\n}\n\nif (item.amount) {\n  blocks.push({\n    type: 'section',\n    fields: [\n      { type: 'mrkdwn', text: `*Amount:* ${item.amount}` }\n    ]\n  });\n}\n\nif (item.email) {\n  blocks.push({\n    type: 'section',\n    fields: [\n      { type: 'mrkdwn', text: `*Account:* ${item.email}` }\n    ]\n  });\n}\n\nif (item.pr_url) {\n  blocks.push({\n    type: 'section',\n    text: { type: 'mrkdwn', text: `<${item.pr_url}|View PR>` }\n  });\n}\n\nreturn [{\n  json: {\n    channel: item.channel,\n    attachments: JSON.stringify([{\n      color: item.color || '#95A5A6',\n      blocks: blocks\n    }])\n  }\n}];"
      }
    },
    {
      "id": "slack-1",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1500, 300],
      "parameters": {
        "channel": "={{ $json.channel }}",
        "text": "=",
        "attachments": "={{ $json.attachments }}"
      }
    }
  ],
  "connections": {
    "OS Notification Webhook": {
      "main": [[{ "node": "Route by Event", "type": "main", "index": 0 }]]
    },
    "Route by Event": {
      "main": [
        [{ "node": "Format: Fix Started", "type": "main", "index": 0 }],
        [{ "node": "Format: PR Created", "type": "main", "index": 0 }],
        [{ "node": "Format: Fix Failed", "type": "main", "index": 0 }],
        [{ "node": "Format: Verification Failed", "type": "main", "index": 0 }],
        [{ "node": "Format: Error", "type": "main", "index": 0 }],
        [{ "node": "Format: Payment Failed", "type": "main", "index": 0 }],
        [{ "node": "Format: Payment Recovered", "type": "main", "index": 0 }],
        [{ "node": "Format: Unknown Event", "type": "main", "index": 0 }]
      ]
    },
    "Format: Fix Started": {
      "main": [[{ "node": "Merge", "type": "main", "index": 0 }]]
    },
    "Format: PR Created": {
      "main": [[{ "node": "Merge", "type": "main", "index": 1 }]]
    },
    "Format: Fix Failed": {
      "main": [[{ "node": "Merge", "type": "main", "index": 2 }]]
    },
    "Format: Verification Failed": {
      "main": [[{ "node": "Merge", "type": "main", "index": 3 }]]
    },
    "Format: Error": {
      "main": [[{ "node": "Merge", "type": "main", "index": 4 }]]
    },
    "Format: Payment Failed": {
      "main": [[{ "node": "Merge", "type": "main", "index": 5 }]]
    },
    "Format: Payment Recovered": {
      "main": [[{ "node": "Merge", "type": "main", "index": 6 }]]
    },
    "Format: Unknown Event": {
      "main": [[{ "node": "Merge", "type": "main", "index": 7 }]]
    },
    "Merge": {
      "main": [[{ "node": "Build Slack Blocks", "type": "main", "index": 0 }]]
    },
    "Build Slack Blocks": {
      "main": [[{ "node": "Post to Slack", "type": "main", "index": 0 }]]
    }
  }
}

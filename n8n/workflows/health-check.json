{
  "name": "OS Health Check — every 5min → Slack",
  "nodes": [
    {
      "id": "schedule-1",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300],
      "parameters": {
        "rule": {
          "interval": 5
        }
      }
    },
    {
      "id": "http-health",
      "name": "GET /health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.OS_HEALTH_URL || 'http://opensymphony:4000/health' }}",
        "authentication": "none",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "code-check-health",
      "name": "Check Health Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [750, 300],
      "parameters": {
        "language": "javascript",
        "code": "const response = $input.first().json;\nconst statusCode = response.statusCode || 0;\nconst responseTime = response.responseTime || response.headers?.response_time || 0;\nlet isHealthy = false;\nlet isSlow = false;\nlet alertType = 'none';\n\nif (statusCode === 200) {\n  isHealthy = true;\n} else {\n  isHealthy = false;\n}\n\nif (responseTime > 5000) {\n  isSlow = true;\n}\n\nconst previousState = $getWorkflowStaticData('global').lastStatus;\nconst wasDown = previousState && previousState !== 'healthy';\n\nif (!isHealthy) {\n  alertType = 'down';\n  $getWorkflowStaticData('global').lastStatus = 'down';\n} else if (isSlow) {\n  alertType = 'slow';\n  $getWorkflowStaticData('global').lastStatus = 'slow';\n} else if (wasDown) {\n  alertType = 'recovery';\n  $getWorkflowStaticData('global').lastStatus = 'healthy';\n} else {\n  $getWorkflowStaticData('global').lastStatus = 'healthy';\n}\n\nreturn [{\n  json: {\n    statusCode: statusCode,\n    responseTime: responseTime,\n    isHealthy: isHealthy,\n    isSlow: isSlow,\n    alertType: alertType\n  }\n}];"
      }
    },
    {
      "id": "switch-alert-type",
      "name": "Route by Alert Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [1000, 300],
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.alertType }}",
        "rules": [
          { "value": "down", "output": 0 },
          { "value": "slow", "output": 1 },
          { "value": "recovery", "output": 2 }
        ],
        "fallbackOutput": 3
      }
    },
    {
      "id": "set-down-alert",
      "name": "Format: Down Alert",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1250, 150],
      "parameters": {
        "values": {
          "string": [
            { "name": "color", "value": "#E74C3C" },
            { "name": "title", "value": "🚨 OS is DOWN" },
            { "name": "text", "value": "={{ 'Health check failed — status ' + $json.statusCode }}" },
            { "name": "channel", "value": "#syntaro-alerts" }
          ]
        }
      }
    },
    {
      "id": "set-slow-warning",
      "name": "Format: Slow Warning",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1250, 300],
      "parameters": {
        "values": {
          "string": [
            { "name": "color", "value": "#F39C12" },
            { "name": "title", "value": "⚠️ OS is SLOW" },
            { "name": "text", "value": "={{ 'Response time ' + ($json.responseTime / 1000).toFixed(1) + 's exceeds 5s threshold' }}" },
            { "name": "channel", "value": "#syntaro-alerts" }
          ]
        }
      }
    },
    {
      "id": "set-recovery",
      "name": "Format: All Clear",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1250, 450],
      "parameters": {
        "values": {
          "string": [
            { "name": "color", "value": "#2ECC71" },
            { "name": "title", "value": "✅ OS is Healthy Again" },
            { "name": "text", "value": "={{ 'Health check passed — status ' + $json.statusCode + ' in ' + ($json.responseTime / 1000).toFixed(1) + 's' }}" },
            { "name": "channel", "value": "#syntaro-alerts" }
          ]
        }
      }
    },
    {
      "id": "merge-1",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [1500, 300],
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition"
      }
    },
    {
      "id": "code-build-message",
      "name": "Build Slack Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1750, 300],
      "parameters": {
        "language": "javascript",
        "code": "const item = $input.first().json;\n\nconst blocks = [\n  {\n    type: 'header',\n    text: { type: 'plain_text', text: item.title || 'Health Alert' }\n  },\n  {\n    type: 'section',\n    text: { type: 'mrkdwn', text: item.text || '' }\n  }\n];\n\nreturn [{\n  json: {\n    channel: item.channel,\n    attachments: JSON.stringify([{\n      color: item.color || '#95A5A6',\n      blocks: blocks\n    }])\n  }\n}];"
      }
    },
    {
      "id": "slack-1",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [2000, 300],
      "parameters": {
        "channel": "={{ $json.channel }}",
        "text": "=",
        "attachments": "={{ $json.attachments }}"
      }
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [[{ "node": "GET /health", "type": "main", "index": 0 }]]
    },
    "GET /health": {
      "main": [[{ "node": "Check Health Status", "type": "main", "index": 0 }]]
    },
    "Check Health Status": {
      "main": [[{ "node": "Route by Alert Type", "type": "main", "index": 0 }]]
    },
    "Route by Alert Type": {
      "main": [
        [{ "node": "Format: Down Alert", "type": "main", "index": 0 }],
        [{ "node": "Format: Slow Warning", "type": "main", "index": 0 }],
        [{ "node": "Format: All Clear", "type": "main", "index": 0 }],
        []
      ]
    },
    "Format: Down Alert": {
      "main": [[{ "node": "Merge", "type": "main", "index": 0 }]]
    },
    "Format: Slow Warning": {
      "main": [[{ "node": "Merge", "type": "main", "index": 1 }]]
    },
    "Format: All Clear": {
      "main": [[{ "node": "Merge", "type": "main", "index": 2 }]]
    },
    "Merge": {
      "main": [[{ "node": "Build Slack Message", "type": "main", "index": 0 }]]
    },
    "Build Slack Message": {
      "main": [[{ "node": "Post to Slack", "type": "main", "index": 0 }]]
    }
  }
}

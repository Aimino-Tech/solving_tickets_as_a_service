              "name": "message",
              "value": "Blog post received, cross-posting initiated"
            }
          ]
        }
      },
      "credentials": {}
    },
    {
      "id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
      "name": "Format Post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300],
      "parameters": {
        "mode": "raw",
        "language": "javaScript",
        "code": "// Blog → Social Formatting Script\n// Input: { title, link, excerpt, author, publishedDate, slug, tags? }\n\nconst item = $input.first().json;\n\nconst title = item.title || '';\nconst link = item.link || '';\nconst excerpt = item.excerpt || '';\nconst author = item.author || 'Team';\nconst tags = item.tags || [];\nconst blogName = item.blogName || 'Our Blog';\n\n// --- Twitter / X (280 chars, but X Premium allows longer) ---\nconst tweetMaxLength = 280;\nconst tweetLink = link || '';\nconst tweetPrefix = `${title}\\n\\n`;\n\nlet tweetBody = excerpt;\n// Truncate excerpt if the full tweet would exceed the character limit\nconst tweetSuffix = `\\n\\n${tweetLink}`;\nconst fullTweetLength = tweetPrefix.length + tweetBody.length + tweetSuffix.length;\n\nif (fullTweetLength > tweetMaxLength) {\n  const maxBodyLength = tweetMaxLength - tweetPrefix.length - tweetSuffix.length - 3; // 3 for '...'\n  tweetBody = tweetBody.substring(0, maxBodyLength) + '...';\n}\n\nconst tweet = `${tweetPrefix}${tweetBody}${tweetSuffix}`;\n\n// --- LinkedIn (richer, supports article-style shares) ---\nconst linkedInComment = `Just published: ${title}\\n\\n${excerpt}\\n\\nRead the full article here: ${link}`;\n\nconst linkedInTitle = title;\nconst linkedInDescription = excerpt.length > 250 ? excerpt.substring(0, 247) + '...' : excerpt;\nconst linkedInArticleUrl = link;\n\nreturn [\n  {\n    json: {\n      // Original data passes through\n      title,\n      link,\n      excerpt,\n      author,\n      publishedDate: item.publishedDate,\n      tags,\n      blogName,\n      // Formatted outputs for each platform\n      tweet,\n      linkedInComment,\n      linkedInTitle,\n      linkedInDescription,\n      linkedInArticleUrl,\n    }\n  }\n];"
      },
      "credentials": {}
    },
    {
      "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
      "name": "Post to Twitter",
      "type": "n8n-nodes-base.twitter",
      "typeVersion": 1,
      "position": [650, 200],
      "parameters": {
        "resource": "tweet",
        "operation": "create",
        "text": "={{ $json.tweet }}",
        "additionalFields": {}
      },
      "credentials": {
        "twitterOAuth2Api": "Twitter Blog Cross-Post Bot"
      }
    },
    {
      "id": "d4e5f6a7-b8c9-0123-defa-234567890123",
      "name": "Post to LinkedIn",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 1,
      "position": [650, 400],
      "parameters": {
        "resource": "share",
        "operation": "create",
        "shareOwner": "={{ $json.authorId || 'urn:li:organization:default' }}",
        "shareContent": {
          "shareCommentary": "={{ $json.linkedInComment }}",
          "shareMediaCategory": "ARTICLE",
          "shareArticle": {
            "title": "={{ $json.linkedInTitle }}",
            "description": "={{ $json.linkedInDescription }}",
            "sourceUrl": "={{ $json.linkedInArticleUrl }}",
            "thumbnailUrl": "={{ $json.thumbnailUrl || '' }}"
          }
        },
        "visibility": "PUBLIC"
      },
      "credentials": {
        "linkedInOAuth2Api": "LinkedIn Blog Cross-Post Bot"
      }
    },

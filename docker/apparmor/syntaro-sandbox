#include <tunables/global>

profile stas-sandbox flags=(attach_disconnected, mediate_deleted) {

  #include <abstractions/base>
  #include <abstractions/nameservice>

  # Network access — only DNS and outbound HTTP(S) via proxy
  network inet stream,
  network inet dgram,
  network inet6 stream,

  # Capabilities — strictly limited
  capability chown,
  capability dac_override,
  capability dac_read_search,
  capability fowner,
  capability fsetid,
  capability setgid,
  capability setuid,
  capability net_bind_service,
  capability net_raw,
  capability sys_ptrace,

  # ── Workspace directory: full access ──
  /home/node/** rwkl,
  /home/node/ rw,

  # ── Read-only system paths ──
  /bin/** rix,
  /usr/bin/** rix,
  /usr/lib/** rix,
  /lib/** rix,
  /lib64/** rix,
  /etc/ld.so.cache r,

  # ── Read-only config files ──
  /etc/passwd r,
  /etc/group r,
  /etc/nsswitch.conf r,
  /etc/resolv.conf r,
  /etc/hosts r,
  /etc/hostname r,
  /etc/ssl/** r,
  /etc/ca-certificates/** r,

  # ── Temp directories: read-write ──
  /tmp/ rw,
  /tmp/** rwkl,

  # ── Blocked paths ──
  deny /proc/** rw,
  deny /sys/** rw,
  deny /dev/** rw,
  deny /etc/shadow rw,
  deny /etc/gshadow rw,
  deny /root/** rw,
  deny /var/log/** rw,
  deny /var/run/** rw,
  deny /boot/** rw,
  deny /usr/share/** w,

  # ── ptrace: only signal same-UID processes (no arbitrary tracing) ──
  ptrace (read, trace) peer=/home/node/**,
  ptrace (send) peer=/home/node/**,

  # ── Signal: allow signals within the same profile ──
  signal set peer=/home/node/**,
}

            "rawSql": "SELECT event_type, COUNT(*) AS value FROM funnel_events WHERE occurred_at >= DATE('now', '-30 days') GROUP BY event_type ORDER BY value DESC",
            "format": "table",
            "refId": "A"
          }
        ]
      }
    ],

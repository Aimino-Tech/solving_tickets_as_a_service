          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "textMode": "auto"
        },
        "targets": [
          {
            "rawSql": "SELECT COALESCE(AVG(consideration_to_conversion), 0) AS value FROM campaign_performance WHERE computed_at = (SELECT MAX(computed_at) FROM campaign_performance)",
            "format": "table",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Funnel Events Over Time",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
        "datasource": { "type": "grafana-duckdb-datasource", "uid": "P0DuckDB" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "axisLabel": "",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "line",
              "fillOpacity": 20,
              "gradientMode": "none",
              "hideFrom": { "legend": false, "tooltip": false, "viz": false },
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "pointSize": 3,
              "scaleDistribution": { "type": "linear" },
              "showPoints": "never",
              "spanNulls": true,
              "stacking": { "group": "A", "mode": "normal" },
              "thresholdsStyle": { "mode": "off" }
            },
            "mappings": [],
            "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
            "unit": "none"
          },
          "overrides": [
            { "matcher": { "id": "byName", "options": "awareness" }, "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "engagement" }, "properties": [{ "id": "color", "value": { "fixedColor": "#5794F2", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "conversion" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF85D0", "mode": "fixed" } }] }
          ]
        },
        "options": {
          "legend": { "calcs": ["max", "last"], "displayMode": "table", "placement": "bottom", "showLegend": true },
          "tooltip": { "mode": "multi", "sort": "none" }
        },
        "targets": [
          {
            "rawSql": "SELECT DATE(occurred_at) AS time, event_type, COUNT(*) AS value FROM funnel_events WHERE $__timeFilter(occurred_at) GROUP BY DATE(occurred_at), event_type ORDER BY time",
            "format": "time_series",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Funnel Drop-off Analysis",
        "type": "table",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
        "datasource": { "type": "grafana-duckdb-datasource", "uid": "P0DuckDB" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "custom": { "align": "auto", "displayMode": "auto" },
            "mappings": [],
            "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
            "unit": "none"
          },
          "overrides": [
            { "matcher": { "id": "byName", "options": "drop_off" }, "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "color", "value": { "mode": "thresholds" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 30 },
                { "color": "red", "value": 60 }
              ]}}
            ]}
          ]
        },
        "options": {
          "cellHeight": "sm",
          "footer": { "countRows": false, "enablePagination": false, "fields": "", "reducer": ["sum"] },
          "showHeader": true,
          "sortBy": [{ "desc": true, "displayName": "computed_at" }]
        },
        "targets": [
          {
            "rawSql": "SELECT c.name AS campaign, p.computed_at, p.awareness_count, p.engagement_count, p.interest_count, p.consideration_count, p.conversion_count, p.retention_count, ROUND((1.0 - p.engagement_count * 1.0 / NULLIF(p.awareness_count, 0)) * 100, 1) AS drop_off FROM campaign_performance p JOIN campaigns c ON c.id = p.campaign_id WHERE p.id IN (SELECT MAX(id) FROM campaign_performance GROUP BY campaign_id) ORDER BY drop_off DESC",
            "format": "table",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "title": "Conversion Flow",
        "type": "bargauge",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
        "datasource": { "type": "grafana-duckdb-datasource", "uid": "P0DuckDB" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
            "unit": "percentunit",
            "decimals": 2,
            "custom": { "minVizWidth": 0, "minVizHeight": 10 }
          },
          "overrides": []
        },
        "options": {
          "displayMode": "gradient",
          "minVizHeight": 10,
          "minVizWidth": 0,
          "orientation": "vertical",
          "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false },
          "showUnfilled": true,
          "valueMode": "text"
        },
        "targets": [
          {
            "rawSql": "SELECT 'A\u2192E' AS conversion, COALESCE(AVG(awareness_to_engagement), 0) AS value FROM campaign_performance WHERE computed_at = (SELECT MAX(computed_at) FROM campaign_performance)",
            "format": "table",
            "refId": "ae"
          },
          {
            "rawSql": "SELECT 'E\u2192I' AS conversion, COALESCE(AVG(engagement_to_interest), 0) AS value FROM campaign_performance WHERE computed_at = (SELECT MAX(computed_at) FROM campaign_performance)",
            "format": "table",
            "refId": "ei"
          },
          {
            "rawSql": "SELECT 'I\u2192C' AS conversion, COALESCE(AVG(interest_to_consideration), 0) AS value FROM campaign_performance WHERE computed_at = (SELECT MAX(computed_at) FROM campaign_performance)",
            "format": "table",
            "refId": "ic"
          },
          {
            "rawSql": "SELECT 'C\u2192V' AS conversion, COALESCE(AVG(consideration_to_conversion), 0) AS value FROM campaign_performance WHERE computed_at = (SELECT MAX(computed_at) FROM campaign_performance)",
            "format": "table",
            "refId": "cv"
          },
          {
            "rawSql": "SELECT 'V\u2192R' AS conversion, COALESCE(AVG(conversion_to_retention), 0) AS value FROM campaign_performance WHERE computed_at = (SELECT MAX(computed_at) FROM campaign_performance)",
            "format": "table",
            "refId": "vr"
          }
        ]
      },
      {
        "id": 9,
        "title": "Funnel Summary",
        "type": "table",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 13 },
        "datasource": { "type": "grafana-duckdb-datasource", "uid": "P0DuckDB" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "custom": { "align": "auto", "displayMode": "auto" },
            "mappings": [],
            "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
            "unit": "none"
          },
          "overrides": []
        },
        "options": {
          "cellHeight": "sm",
          "footer": { "countRows": false, "enablePagination": false, "fields": "", "reducer": ["sum"] },
          "showHeader": true,
          "sortBy": [{ "desc": true, "displayName": "computed_at" }]
        },
        "targets": [
          {
            "rawSql": "SELECT c.name, p.computed_at, p.total_signals, p.positive_signals, p.negative_signals, ROUND(p.signal_ratio, 2) AS signal_ratio, p.estimated_reach, ROUND(p.engagement_rate, 3) AS eng_rate, ROUND(p.quality_score, 1) AS quality FROM campaign_performance p JOIN campaigns c ON c.id = p.campaign_id WHERE p.id IN (SELECT MAX(id) FROM campaign_performance GROUP BY campaign_id) ORDER BY p.computed_at DESC",
            "format": "table",
            "refId": "A"
          }
        ]
      },

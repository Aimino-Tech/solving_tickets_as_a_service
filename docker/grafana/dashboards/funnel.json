          }
        ]
      },
      {
        "id": 5,
        "title": "C \u2192 V Rate",
        "type": "stat",
        "gridPos": { "h": 5, "w": 3, "x": 17, "y": 0 },
        "datasource": { "type": "grafana-duckdb-datasource", "uid": "P0DuckDB" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "yellow", "value": 0.15 },
              { "color": "green", "value": 0.25 }
            ]},
            "unit": "percentunit",

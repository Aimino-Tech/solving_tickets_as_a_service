        "id": 4,
        "title": "I \u2192 C Rate",
        "type": "stat",
        "gridPos": { "h": 5, "w": 3, "x": 14, "y": 0 },
        "datasource": { "type": "grafana-duckdb-datasource", "uid": "P0DuckDB" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "red", "value": null },

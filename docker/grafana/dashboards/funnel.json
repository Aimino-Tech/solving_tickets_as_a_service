{
  "dashboard": {
    "id": null,
    "uid": "funnel",
    "title": "Marketing Funnel",
    "description": "Conversion funnel visualization: awareness \u2192 engagement \u2192 interest \u2192 consideration \u2192 conversion \u2192 retention. Tracks user progression and drop-off at each stage.",
    "tags": ["hermes", "marketing", "funnel"],
    "timezone": "utc",
    "editable": true,
    "graphTooltip": 1,
    "weekStart": "monday",
    "refresh": "10m",
    "schemaVersion": 38,
    "version": 1,
    "panels": [
      {
        "id": 1,
        "title": "Funnel Overview",
        "type": "bargauge",
        "gridPos": { "h": 10, "w": 8, "x": 0, "y": 0 },
        "datasource": { "type": "grafana-duckdb-datasource", "uid": "P0DuckDB" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "semi-dark-green", "value": null },
              { "color": "semi-dark-blue", "value": 5 },
              { "color": "semi-dark-purple", "value": 20 },
              { "color": "semi-dark-orange", "value": 50 },
              { "color": "semi-dark-red", "value": 100 }
            ]},
            "unit": "none",
            "custom": { "minVizWidth": 0, "minVizHeight": 10 }
          },
          "overrides": [
            { "matcher": { "id": "byName", "options": "Awareness" }, "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Engagement" }, "properties": [{ "id": "color", "value": { "fixedColor": "#5794F2", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Interest" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Consideration" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF4444", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Conversion" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF85D0", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Retention" }, "properties": [{ "id": "color", "value": { "fixedColor": "#B877D9", "mode": "fixed" } }] }
          ]
        },
        "options": {
          "displayMode": "gradient",
          "minVizHeight": 10,
          "minVizWidth": 0,
          "orientation": "horizontal",
          "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
          "showUnfilled": true,
          "valueMode": "text"
        },
        "targets": [
          {
            "rawSql": "SELECT 'Awareness' AS stage, COALESCE(SUM(awareness_count), 0) AS value FROM campaign_performance WHERE computed_at = (SELECT MAX(computed_at) FROM campaign_performance)",
            "format": "table",
            "refId": "awareness"
          },
          {
            "rawSql": "SELECT 'Engagement' AS stage, COALESCE(SUM(engagement_count), 0) AS value FROM campaign_performance WHERE computed_at = (SELECT MAX(computed_at) FROM campaign_performance)",
            "format": "table",
            "refId": "engagement"
          },
          {
            "rawSql": "SELECT 'Interest' AS stage, COALESCE(SUM(interest_count), 0) AS value FROM campaign_performance WHERE computed_at = (SELECT MAX(computed_at) FROM campaign_performance)",
            "format": "table",
            "refId": "interest"
          },
          {
            "rawSql": "SELECT 'Consideration' AS stage, COALESCE(SUM(consideration_count), 0) AS value FROM campaign_performance WHERE computed_at = (SELECT MAX(computed_at) FROM campaign_performance)",
            "format": "table",
            "refId": "consideration"
          },
          {
            "rawSql": "SELECT 'Conversion' AS stage, COALESCE(SUM(conversion_count), 0) AS value FROM campaign_performance WHERE computed_at = (SELECT MAX(computed_at) FROM campaign_performance)",
            "format": "table",
            "refId": "conversion"
          },
          {
            "rawSql": "SELECT 'Retention' AS stage, COALESCE(SUM(retention_count), 0) AS value FROM campaign_performance WHERE computed_at = (SELECT MAX(computed_at) FROM campaign_performance)",
            "format": "table",
            "refId": "retention"
          }
        ]
      },
      {
        "id": 2,
        "title": "A \u2192 E Rate",
        "type": "stat",
        "gridPos": { "h": 5, "w": 3, "x": 8, "y": 0 },
        "datasource": { "type": "grafana-duckdb-datasource", "uid": "P0DuckDB" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "yellow", "value": 0.3 },
              { "color": "green", "value": 0.5 }
            ]},
            "unit": "percentunit",
            "decimals": 1
          },
          "overrides": []
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "textMode": "auto"
        },
        "targets": [
          {
            "rawSql": "SELECT COALESCE(AVG(awareness_to_engagement), 0) AS value FROM campaign_performance WHERE computed_at = (SELECT MAX(computed_at) FROM campaign_performance)",
            "format": "table",
            "refId": "A"
          }

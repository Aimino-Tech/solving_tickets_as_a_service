            "rawSql": "SELECT DATE(collected_at) AS time, SUM(github_stars) AS github_stars, SUM(npm_downloads) AS npm_downloads FROM metrics WHERE $__timeFilter(collected_at) GROUP BY DATE(collected_at) ORDER BY time",
            "format": "time_series",
            "refId": "A"
          }
        ]
      },
      {
        "id": 13,
        "title": "Campaign vs Metrics Correlation",
        "type": "table",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
        "datasource": { "type": "grafana-duckdb-datasource", "uid": "P0DuckDB" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "custom": { "align": "auto", "displayMode": "auto" },
            "mappings": [],
            "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
            "unit": "none"
          },
          "overrides": [
            { "matcher": { "id": "byName", "options": "star_growth" }, "properties": [{ "id": "unit", "value": "short" }, { "id": "decimals", "value": 0 }] },
            { "matcher": { "id": "byName", "options": "dl_growth" }, "properties": [{ "id": "unit", "value": "short" }, { "id": "decimals", "value": 0 }] }
          ]
        },
        "options": {
          "cellHeight": "sm",
          "footer": { "countRows": false, "enablePagination": false, "fields": "", "reducer": ["sum"] },
          "showHeader": true,
          "sortBy": [{ "desc": true, "displayName": "star_growth" }]
        },
        "targets": [
          {
            "rawSql": "SELECT c.name AS campaign, c.status, COUNT(a.id) AS total_actions, COALESCE(MAX(m.github_stars), 0) AS github_stars, COALESCE(MAX(m.npm_downloads), 0) AS npm_downloads, (COALESCE(MAX(m.github_stars), 0) - COALESCE(MIN(m.github_stars), 0)) AS star_growth, (COALESCE(MAX(m.npm_downloads), 0) - COALESCE(MIN(m.npm_downloads), 0)) AS dl_growth FROM campaigns c LEFT JOIN actions a ON a.campaign_id = c.id LEFT JOIN metrics m ON m.campaign_id = c.id GROUP BY c.id, c.name, c.status ORDER BY star_growth DESC",
            "format": "table",
            "refId": "A"
          }
        ]
      }

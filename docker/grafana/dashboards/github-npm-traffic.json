            "format": "table",
            "refId": "A"
          }
        ]
      },
      {
        "id": 9,
        "title": "Stars 7d Forecast",
        "type": "stat",
        "gridPos": { "h": 4, "w": 3, "x": 18, "y": 8 },
        "datasource": { "type": "grafana-duckdb-datasource", "uid": "P0DuckDB" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "noValue": "0",
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "text", "value": null },
              { "color": "purple", "value": 1 }
            ]},
            "unit": "short",
            "decimals": 0
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "textMode": "auto"
        },
        "targets": [
          {
            "rawSql": "WITH daily AS (SELECT DATE(collected_at) AS d, MAX(github_stars) AS s FROM metrics GROUP BY d), trend AS (SELECT AVG(s) AS avg_stars, (MAX(s) - MIN(s)) / NULLIF(COUNT(*), 1) AS daily_delta FROM daily WHERE d >= DATE('now', '-14 days')) SELECT CAST(ROUND((SELECT s FROM daily ORDER BY d DESC LIMIT 1) + 7 * daily_delta) AS INTEGER) AS value FROM trend",
            "format": "table",
            "refId": "A"
          }
        ]
      },
      {
        "id": 10,
        "title": "Downloads 7d Forecast",
        "type": "stat",
        "gridPos": { "h": 4, "w": 3, "x": 21, "y": 8 },
        "datasource": { "type": "grafana-duckdb-datasource", "uid": "P0DuckDB" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "noValue": "0",
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "text", "value": null },

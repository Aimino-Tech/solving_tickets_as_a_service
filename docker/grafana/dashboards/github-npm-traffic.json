        },
        "targets": [
          {
            "rawSql": "WITH daily AS (SELECT DATE(collected_at) AS d, MAX(npm_downloads) AS dl FROM metrics GROUP BY d), trend AS (SELECT AVG(dl) AS avg_dl, (MAX(dl) - MIN(dl)) / NULLIF(COUNT(*), 1) AS daily_delta FROM daily WHERE d >= DATE('now', '-14 days')) SELECT CAST(ROUND((SELECT dl FROM daily ORDER BY d DESC LIMIT 1) + 7 * daily_delta) AS INTEGER) AS value FROM trend",
            "format": "table",
            "refId": "A"
          }
        ]
      },

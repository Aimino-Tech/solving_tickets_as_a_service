      {
        "id": 7,
        "title": "Stars Growth Rate",
        "type": "stat",
        "gridPos": { "h": 4, "w": 3, "x": 12, "y": 8 },
        "datasource": { "type": "grafana-duckdb-datasource", "uid": "P0DuckDB" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "noValue": "0%",
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0 },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 25 }
            ]},
            "unit": "percent",
            "decimals": 1
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "textMode": "auto"
        },
        "targets": [
          {
            "rawSql": "WITH star_data AS (SELECT MIN(github_stars) AS old_stars, MAX(github_stars) AS new_stars FROM metrics WHERE collected_at >= DATE('now', '-30 days')) SELECT CASE WHEN old_stars > 0 THEN ROUND(100.0 * (new_stars - old_stars) / old_stars, 1) ELSE 0 END AS value FROM star_data",
            "format": "table",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,

          "showHeader": true,
          "sortBy": [{ "desc": true, "displayName": "collected_at" }]
        },
        "targets": [
          {
            "rawSql": "SELECT m.collected_at, c.name AS campaign, m.github_stars, m.npm_downloads, m.x_mentions, m.sheet_row_count FROM metrics m JOIN campaigns c ON c.id = m.campaign_id WHERE $__timeFilter(m.collected_at) ORDER BY m.collected_at DESC LIMIT 100",
            "format": "table",
            "refId": "A"
          }
        ]

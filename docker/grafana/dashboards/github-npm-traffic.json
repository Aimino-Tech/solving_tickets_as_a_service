              { "id": "custom.fillOpacity", "value": 20 },
              { "id": "custom.lineWidth", "value": 3 }
            ]},
            { "matcher": { "id": "byName", "options": "npm_downloads" }, "properties": [
              { "id": "color", "value": { "fixedColor": "#cb3837", "mode": "fixed" } },

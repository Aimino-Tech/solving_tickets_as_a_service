{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 5,
    "restartPolicyType": "always",
    "restartPolicyMaxRetries": 10
  },
  "services": [
    {
      "name": "bot",
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile"
      }
    }
  ],
  "plugins": [
    "redis"
  ],
  "env": {
    "NODE_ENV": {
      "value": "production"
    },
    "PORT": {
      "value": "3000"
    },
    "RUN_MODE": {
      "value": "both"
    },
    "REDIS_URL": {
      "plugin": "redis"
    },
    "OPENCODE_URL": {
      "description": "URL of your OpenCode serve instance (e.g. http://opencode:4096 if deployed alongside)"
    },
    "OPENCODE_MODEL": {
      "value": "anthropic/claude-sonnet-4-20250514"
    },
    "LOG_LEVEL": {
      "value": "info"
    },
    "GITHUB_APP_ID": {
      "description": "Your GitHub App ID"
    },
    "GITHUB_APP_PRIVATE_KEY": {
      "description": "Your GitHub App private key (PEM content)"
    },
    "GITHUB_WEBHOOK_SECRET": {
      "description": "Your GitHub App webhook secret"
    }
  }
}

# SYNTARO Premium — environment variables for hosted service
# These are NOT part of the OSS MIT codebase.

# GitHub App (same as OSS)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Premium: use our AGI instead of user's self-hosted agent
SYNTARO_PREMIUM=true
OPENCODE_URL=https://agi.syntaro.dev/v1  # Our AGI endpoint
OPENCODE_MODEL=aimino/agi-v1

# Premium: database
DATABASE_URL=postgres://user:pass@host:5432/syntaro
DASHBOARD_URL=https://dashboard.syntaro.dev

# Premium: billing
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Premium: sandbox
E2B_API_KEY=e2b_...
SANDBOX_POOL_SIZE=10

# Premium: features
SYNTARO_MAX_CONCURRENT=10
SYNTARO_AUDIT_LOG=true
SYNTARO_SSO_ENABLED=false

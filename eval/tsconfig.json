{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "../dist-eval"
  },
  "include": ["./**/*.ts"],
  "exclude": ["../src", "../dashboard", "../plugin", "../premium", "../workers", "../node_modules"]
}

#!/usr/bin/env python3
"""
Daily Marketing Monitoring Report

Aggregates metrics from guerrilla-content-plan and generates a summary.
Run daily via cron job.

Usage:
    python3 daily_monitoring_report.py
"""

import os
import json
from datetime import datetime, timezone, timedelta
from collections import Counter, defaultdict
from google.oauth2.service_account import Credentials
from google.auth.transport.requests import Request
import requests

# ── Config ──────────────────────────────────────────────────────────────────
SHEET_ID = "1Nf_H61D4GGq5aFlypAHlW_f1Uaso1c4OmJ9QRz5qRaY"
SA_PATH = os.path.expanduser("~/Documents/hermes-agent/service-account-key.json")
STATE_FILE = os.path.expanduser("~/.hermes/pipeline_state.json")


def get_sheets_client():
    creds = Credentials.from_service_account_file(SA_PATH, scopes=[
        "https://www.googleapis.com/auth/spreadsheets",
        "https://www.googleapis.com/auth/drive"
    ])
    creds.refresh(Request())
    headers = {"Authorization": f"Bearer {creds.token}"}
    return creds, headers


def read_sheet_range(headers, sheet_name, cell_range):
    import urllib.parse
    range_str = f"{sheet_name}!{cell_range}"
    encoded_range = urllib.parse.quote(range_str)
    url = f"https://sheets.googleapis.com/v4/spreadsheets/{SHEET_ID}/values/{encoded_range}"
    r = requests.get(url, headers=headers, timeout=30)
    r.raise_for_status()
    return r.json().get("values", [])


def load_state():
    if os.path.exists(STATE_FILE):
        with open(STATE_FILE) as f:
            return json.load(f)
    return {}


def main():
    print(f"📊 Daily Marketing Monitoring Report")
    print(f"📅 {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print("=" * 60)
    
    # Load state
    state = load_state()
    
    # Connect to Sheets
    creds, headers = get_sheets_client()
    
    # Read guerrilla-content-plan
    rows = read_sheet_range(headers, "guerrilla-content-plan", "A2:M")
    
    # Parse data
    total_posts = len(rows)
    status_counts = Counter()
    platform_counts = Counter()
    product_counts = Counter()
    approval_counts = Counter()
    
    for row in rows:
        if not row:
            continue
        
        content_id = row[0] if len(row) > 0 else ""
        platform = row[2] if len(row) > 2 else ""
        approval = row[8] if len(row) > 8 else ""
        status = row[9] if len(row) > 9 else ""
        
        # Count by status
        if status:
            status_counts[status] += 1
        
        # Count by platform
        if platform:
            # Extract main platform
            if "Reddit" in platform:
                platform_counts["Reddit"] += 1
            elif "Hacker News" in platform:
                platform_counts["Hacker News"] += 1
            elif "LinkedIn" in platform:
                platform_counts["LinkedIn"] += 1
            elif "Twitter" in platform:
                platform_counts["Twitter"] += 1
            else:
                platform_counts[platform] += 1
        
        # Count by product (prefix)
        if content_id:
            prefix = ''.join(c for c in content_id if c.isalpha())
            if prefix:
                product_counts[prefix] += 1
        
        # Count by approval
        if approval:
            approval_counts[approval] += 1
    
    # Print summary
    print(f"\n📦 TOTAL CONTENT: {total_posts} rows")
    
    print(f"\n🎯 BY STATUS:")
    for status, count in status_counts.most_common():
        print(f"  {status}: {count}")
    
    print(f"\n🌐 BY PLATFORM:")
    for platform, count in platform_counts.most_common():
        print(f"  {platform}: {count}")
    
    print(f"\n🏷️  BY PRODUCT:")
    for product, count in product_counts.most_common():
        print(f"  {product}: {count}")
    
    print(f"\n✅ BY APPROVAL:")
    for approval, count in approval_counts.most_common():
        print(f"  {approval}: {count}")
    
    # Pipeline health check
    print(f"\n{'=' * 60}")
    print(f"🏥 PIPELINE HEALTH CHECK")
    print(f"{'=' * 60}")
    
    planned = status_counts.get("📋 planned", 0)
    replied = status_counts.get("✅ Replied", 0) + status_counts.get("✅ Repled", 0)
    skipped = status_counts.get("⏭️ Skipped", 0)
    rejected = status_counts.get("❌ Rejected", 0)
    
    print(f"  📋 Planned (waiting): {planned}")
    print(f"  ✅ Replied (done): {replied}")
    print(f"  ⏭️ Skipped: {skipped}")
    print(f"  ❌ Rejected: {rejected}")
    
    # Conversion rate
    success_rate = 0.0
    total_actionable = replied + skipped + rejected
    if total_actionable > 0:
        success_rate = (replied / total_actionable) * 100
        print(f"\n  📈 Success Rate: {success_rate:.1f}% ({replied}/{total_actionable})")
    
    # New products check
    campaigns = state.get("campaigns_generated", [])
    if campaigns:
        print(f"\n🆕 RECENT CAMPAIGNS GENERATED:")
        for c in campaigns[-5:]:
            print(f"  - {c['product_id']}: {c['rows_count']} rows ({c['generated_at'][:10]})")
    
    # Recommendations
    print(f"\n{'=' * 60}")
    print(f"💡 RECOMMENDATIONS")
    print(f"{'=' * 60}")
    
    if planned > 200:
        print(f"  ⚠️  High backlog ({planned} planned). Consider posting more frequently.")
    
    if replied > 0 and total_actionable > 0:
        if success_rate < 50:
            print(f"  ⚠️  Low success rate ({success_rate:.1f}%). Review rejected/skipped items.")
        elif success_rate > 80:
            print(f"  ✅ Great success rate ({success_rate:.1f}%)! Keep up the momentum.")
    
    # Check if we have products without campaigns
    product_ids = set(product_counts.keys())
    all_products = {"ODW", "OCSKILLS", "SEAM", "MF", "OT", "HN", "G", "OC", "REDDIT", "RD", "R", "ODA"}
    missing = all_products - product_ids
    if missing:
        print(f"  ⚠️  Products without campaigns: {', '.join(missing)}")
    
    print(f"\n{'=' * 60}")
    print(f"✅ Report complete!")


if __name__ == "__main__":
    main()

#!/bin/sh
# STAS pre-commit hook — secret scanning + template validation
# Installed via: ln -sf ../../.githooks/pre-commit .git/hooks/pre-commit
#
# REQUIREMENTS:
#   - gitleaks (https://github.com/gitleaks/gitleaks)
#     macOS: brew install gitleaks
#     Linux: curl -sSfL https://github.com/gitleaks/gitleaks/releases/latest/download/gitleaks-linux-amd64 -o /usr/local/bin/gitleaks && chmod +x /usr/local/bin/gitleaks

set -e

HAS_ERRORS=0

# ── Gitleaks secret scan ────────────────────────────────────────────────────
if command -v gitleaks >/dev/null 2>&1; then
  echo "STAS: Running gitleaks secret scan..."
  if ! gitleaks detect --source . --staged --no-git -v 2>/dev/null; then
    echo "STAS: ✗ gitleaks detected potential secrets in staged changes."
    echo "STAS:    Review the findings above. If false positive, add to .gitleaksignore"
    HAS_ERRORS=1
  else
    echo "STAS: ✓ gitleaks: no secrets detected"
  fi
else
  echo "STAS: ⚠ gitleaks not installed — skipping secret scan."
  echo "STAS:   Install: brew install gitleaks (macOS) or see .githooks/pre-commit for Linux"
fi

# ── Template validation ────────────────────────────────────────────────────
CHANGED_TEMPLATES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^\.stas/templates/.+\.(yaml|yml)$' || true)

if [ -n "$CHANGED_TEMPLATES" ]; then
  echo "STAS: Validating changed template files..."
  for file in $CHANGED_TEMPLATES; do
    if [ -f "$file" ]; then
      if ! npx tsx "$(dirname "$0")/../src/template/cli.ts" template validate --file "$file" --format json > /dev/null 2>&1; then
        echo "STAS: ✗ Validation failed for $file"
        npx tsx "$(dirname "$0")/../src/template/cli.ts" template validate --file "$file"
        HAS_ERRORS=1
      else
        echo "STAS: ✓ $file is valid"
      fi
    fi
  done
fi

if [ "$HAS_ERRORS" -ne 0 ]; then
  echo ""
  echo "STAS: Pre-commit checks failed. Commit blocked."
  exit 1
fi

echo "STAS: All checks passed."

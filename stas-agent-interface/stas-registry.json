  "package_version": "0.1.0",
  "description": "Unified Agent Interface Layer - MCP SDK + Discovery + Auth for STAS",
  "protocols": {"mcp": {"version":"2024-11-05","transport":"sse","default_port":4094,"stdio_command":"stas-mcp --stdio"},"rest": {"version":"1.0.0","transport":"http","default_port":8090,"health_endpoint":"/health"}},
  "capabilities": [

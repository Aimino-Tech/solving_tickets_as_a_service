    {"name":"submit_issue","description":"Submit a GitHub issue to the STAS fix pipeline","scope":"write","mcp_tool":true,"rest_endpoint":"POST /issue"},
    {"name":"check_status","description":"Check phased progress of a fix run","scope":"read","mcp_tool":true,"rest_endpoint":"GET /status/{run_id}"},
    {"name":"get_run_history","description":"List recent fix runs","scope":"read","mcp_tool":true,"rest_endpoint":"GET /history"},
    {"name":"list_repos","description":"List configured repositories","scope":"read","mcp_tool":true,"rest_endpoint":"GET /repos"},

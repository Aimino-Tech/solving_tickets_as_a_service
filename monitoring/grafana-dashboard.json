{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": "1.0.0"
    }
  ],
  "title": "STAS — Production Monitoring (500-User Scale)",
  "description": "Production monitoring for STAS at 500-user scale — queue monitoring, cost tracking, per-tenant metrics, rate limits, and infrastructure health",
  "tags": ["stas", "production", "cost", "scaling", "500-users"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Queue Depth — Main Queues",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "queue_depth{queue=~\"stas\\\\.(issues|agents|events)\\\\.*\"}",
          "legendFormat": "{{queue}} ({{type}})",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "DLQ Depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "queue_depth{queue=~\".*\\\\.dlq\"}",
          "legendFormat": "{{queue}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Message Processing Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(messages_consumed_total[5m])",
          "legendFormat": "Consumed — {{queue}}"
        },
        {
          "expr": "rate(messages_published_total[5m])",
          "legendFormat": "Published — {{queue}}"
        },
        {
          "expr": "rate(messages_failed_total[5m])",
          "legendFormat": "Failed — {{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        }
      }
    },
    {
      "id": 4,
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(messages_failed_total[5m]) / (rate(messages_consumed_total[5m]) + rate(messages_published_total[5m])) * 100",
          "legendFormat": "Error rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Processing Duration (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(processing_duration_seconds_bucket[5m])) by (le, queue))",
          "legendFormat": "p50 — {{queue}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(processing_duration_seconds_bucket[5m])) by (le, queue))",
          "legendFormat": "p95 — {{queue}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(processing_duration_seconds_bucket[5m])) by (le, queue))",
          "legendFormat": "p99 — {{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 6,
      "title": "Consumer Lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "consumer_lag",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    },
    {
      "id": 7,
      "title": "Worker Liveness",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "count(worker_liveness == 1)",
          "legendFormat": "Alive Workers"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Active Tasks",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "tasks_running",
          "legendFormat": "{{worker}} — {{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    },
    {
      "id": 9,
      "title": "Task Success/Failure (5m rate)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(tasks_succeeded_total[5m])",
          "legendFormat": "Success — {{worker}}/{{queue}}"
        },
        {
          "expr": "rate(tasks_failed_total[5m])",
          "legendFormat": "Failed — {{worker}}/{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 10,
      "title": "RabbitMQ Connection Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rabbitmq_up",
          "legendFormat": "RabbitMQ"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "description": "RabbitMQ connection status (1=connected, 0=disconnected)"
    },
    {
      "id": 11,
      "title": "Publish Errors",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 8, "x": 4, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(publish_errors_total[5m])",
          "legendFormat": "{{queue}} — {{error}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        }
      }
    },
    {
      "id": 12,
      "title": "Queue Health Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "queue_health_status",
          "legendFormat": "Health"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      },
      "description": "Overall queue health (0=healthy, 1=degraded, 2=critical)"
    },
    {
      "id": 13,
      "title": "DLQ Messages (Last 24h)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by(queue) (increase(dlq_messages_total[24h]))",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "id": 14,
      "title": "Feature Flag Evaluations",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by(flag, result) (rate(feature_flag_evaluations_total[5m]))",
          "legendFormat": "{{flag}} ({{result}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "min": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 }
        }
      },
      "description": "Rate of feature flag evaluations per second, broken down by flag name and result (enabled/disabled)"
    },
    {
      "id": 15,
      "title": "Feature Flag Overrides",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by(flag, account) (rate(feature_flag_overrides_total[5m]))",
          "legendFormat": "{{flag}} (account {{account}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "min": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 50 }
        }
      },
      "description": "Rate of feature flag override/set operations per second, by flag and account"
    },
    {
      "id": 16,
      "title": "Feature Flag Rollout %",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(feature_flag_evaluations_total{result=\"enabled\"}) / (sum(feature_flag_evaluations_total{result=\"enabled\"}) + sum(feature_flag_evaluations_total{result=\"disabled\"})) * 100",
          "legendFormat": "Rollout %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "green", "value": 50 }
            ]
          }
        }
      },
      "description": "Percentage of feature flag evaluations that returned enabled (rollout adoption)"
    },
    {
      "id": 17,
      "title": "Inference Cost (Hourly)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by(model) (increase(inference_cost_total[1h]))",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "usd",
          "min": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 50 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "description": "Hourly inference cost by model. Alert at >$100/day."
    },
    {
      "id": 18,
      "title": "Cost per Fix",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(increase(inference_cost_total[1h])) / sum(increase(fixes_completed_total[1h]))",
          "legendFormat": "Cost/Fix"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "usd",
          "decimals": 4,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      },
      "description": "Average inference cost per completed fix"
    },
    {
      "id": 19,
      "title": "Monthly Infrastructure Cost",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(infra_cost_by_service)",
          "legendFormat": "Monthly Infra Cost"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "usd",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 750 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      },
      "description": "Projected monthly infrastructure cost for current scale"
    },
    {
      "id": 20,
      "title": "Per-Tenant Fix Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by(account_id) (rate(fixes_completed_total[1h]))",
          "legendFormat": "Tenant {{account_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "description": "Fix completion rate per tenant (top 10 by activity)"
    },
    {
      "id": 21,
      "title": "Per-Tenant API Rate Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by(account_id) (rate(api_requests_total[5m]))",
          "legendFormat": "{{account_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "description": "API request rate per tenant (10 req/min limit for Free tier)"
    }
  ],
  "rows": [],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Flower Dashboard",
      "type": "link",
      "url": "http://localhost:5555",
      "targetBlank": true
    },
    {
      "title": "RabbitMQ Management",
      "type": "link",
      "url": "http://localhost:15672",
      "targetBlank": true
    },
    {
      "title": "Cost Dashboard",
      "type": "link",
      "url": "http://localhost:3000/api/cost",
      "targetBlank": true
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "refresh": "30s"
}

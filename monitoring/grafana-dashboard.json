{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": "1.0.0"
    }
  ],
  "title": "STAS — Scaling & Capacity Dashboard",
  "description": "Dashboard for monitoring STAS scaling metrics: queue depth, fix rate, error rate, latency, worker pool, and cost per fix",
  "tags": ["stas", "scaling", "capacity", "500-users"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Queue Depth — Main Issue Queue",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "queue_depth{queue=~\"stas\\\\.(issues|agents|dispatch)\\\\.*\",type=\"main\"}",
          "legendFormat": "{{queue}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "description": "Depth of the main issue processing queue. Green: <50, Orange: 50-200, Red: >200 (critical). Thresholds correspond to ALERT_WARN_QUEUE_DEPTH and ALERT_CRIT_QUEUE_DEPTH."
    },
    {
      "id": 2,
      "title": "Fix Rate (Success / Total)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(fix_run_total{status=\"success\"}[30m]) / (rate(fix_run_total{status=\"success\"}[30m]) + rate(fix_run_total{status=\"failed\"}[30m])) * 100",
          "legendFormat": "Fix Rate (%)",
          "interval": "30s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          }
        }
      },
      "description": "Percentage of fix runs that completed successfully over a 30-minute rolling window. Target: >80%."
    },
    {
      "id": 3,
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(tasks_failed_total[5m]) / (rate(tasks_succeeded_total[5m]) + rate(tasks_failed_total[5m])) * 100",
          "legendFormat": "Error Rate",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 2 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "description": "Error rate as percentage of total tasks. Green: <2%, Orange: 2-5%, Red: >5% (triggers ErrorRateSpike alert)."
    },
    {
      "id": 4,
      "title": "Processing Latency — P95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(processing_duration_seconds_bucket[5m])) by (le, queue))",
          "legendFormat": "P95 — {{queue}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 120 },
              { "color": "red", "value": 300 }
            ]
          },
          "min": 0
        }
      },
      "description": "P95 processing latency by queue. Green: <2min, Orange: 2-5min, Red: >5min."
    },
    {
      "id": 5,
      "title": "Worker Pool Size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "count(worker_liveness == 1)",
          "legendFormat": "Active Workers",
          "interval": "15s"
        },
        {
          "expr": "sum(worker_total_slots)",
          "legendFormat": "Total Slots",
          "interval": "15s"
        },
        {
          "expr": "sum(worker_busy_slots)",
          "legendFormat": "Busy Slots",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "description": "Active worker count and slot utilization. When busy slots approach total slots, scale up workers."
    },
    {
      "id": 6,
      "title": "Worker Utilization %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(worker_busy_slots) / sum(worker_total_slots) * 100",
          "legendFormat": "Utilization %",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "description": "Overall worker pool utilization. Target: <60% for headroom. >80% triggers WorkerPoolHighUtilization warning."
    },
    {
      "id": 7,
      "title": "Cost Per Fix",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(metering_cost_total[1h]) / rate(fix_run_total{status=\"success\"}[1h])",
          "legendFormat": "Avg Cost/Fix",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 1.0 }
            ]
          }
        }
      },
      "description": "Average cost per successful fix run over the last hour. Green: <$0.50, Orange: $0.50-$1.00, Red: >$1.00."
    },
    {
      "id": 8,
      "title": "DLQ Depth",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "queue_depth{queue=~\"stas\\\\.dlq|.*\\\\.dlq\",type=\"dlq\"}",
          "legendFormat": "{{queue}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "description": "Dead-letter queue depth. Any non-zero value indicates processing failures that need investigation."
    },
    {
      "id": 9,
      "title": "Rate Limit Blocks",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(rate_limit_blocks_total[5m])",
          "legendFormat": "Blocks/s",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        }
      },
      "description": "Rate at which requests are being rate-limited. Spikes indicate users hitting limits."
    },
    {
      "id": 10,
      "title": "Scaling Status",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "scaling_current_workers",
          "legendFormat": "Current Workers"
        },
        {
          "expr": "scaling_max_workers",
          "legendFormat": "Max Workers"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "description": "Current vs max worker count from the scaling API."
    },
    {
      "id": 11,
      "title": "Webhook Throughput",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(webhooks_received_total[5m])",
          "legendFormat": "Received",
          "interval": "15s"
        },
        {
          "expr": "rate(webhooks_processed_total[5m])",
          "legendFormat": "Processed",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        }
      },
      "description": "Webhook receive and processing rates. Gap between received and processed indicates queue backlog."
    },
    {
      "id": 12,
      "title": "Database Pool Utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "pg_pool_active_connections",
          "legendFormat": "Active Connections",
          "interval": "15s"
        },
        {
          "expr": "pg_pool_idle_connections",
          "legendFormat": "Idle Connections",
          "interval": "15s"
        },
        {
          "expr": "pg_pool_total_connections",
          "legendFormat": "Max Connections",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0 },
              { "color": "red", "value": 0 }
            ]
          }
        }
      },
      "description": "PostgreSQL connection pool utilization. Max connections is set by DATABASE_POOL_MAX / SCALING_PG_POOL_MAX."
    },
    {
      "id": 13,
      "title": "Scaling Recommendations",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "scaling_recommendation",
          "legendFormat": "",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "metric": "Metric",
              "value": "Value",
              "recommendation": "Recommendation",
              "priority": "Priority"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        }
      },
      "description": "Real-time scaling recommendations from the scaling management API."
    },
    {
      "id": 14,
      "title": "Processing Duration Distribution",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      },
      "description": "Processing duration percentiles (p50, p95, p99). P95 > 300s triggers HighProcessingLatency alert."
    },
    {
      "id": 15,
      "title": "Message Processing Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(messages_consumed_total[5m])",
          "legendFormat": "Consumed — {{queue}}"
        },
        {
          "expr": "rate(messages_published_total[5m])",
          "legendFormat": "Published — {{queue}}"
        },
        {
          "expr": "rate(messages_failed_total[5m])",
          "legendFormat": "Failed — {{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        }
      },
      "description": "Message processing rates by queue. Consumed should roughly match published in steady state."
    }
  ],
  "rows": [],
  "templating": {
    "list": [
      {
        "name": "queue_filter",
        "type": "query",
        "query": "label_values(queue_depth, queue)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allFormat": "regex wildcard",
        "current": { "text": "All", "value": "$__all" },
        "label": "Queue Filter"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Scale Event",
        "type": "events",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "scaling_events_total",
        "iconColor": "blue",
        "enable": true,
        "titleFormat": "Scale Event",
        "textFormat": "{{type}}: {{from}} -> {{to}} workers"
      },
      {
        "name": "Alert Firing",
        "type": "dashboard",
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{severity=~\"warning|critical\"}"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Celery & Queue Dashboard",
      "type": "link",
      "url": "/d/queue-monitoring",
      "targetBlank": true
    },
    {
      "title": "Scaling Documentation",
      "type": "link",
      "url": "https://github.com/tamnguyen08/solving_tickets_as_a_service/docs/SCALING.md",
      "targetBlank": true
    },
    {
      "title": "Prometheus Alerts",
      "type": "link",
      "url": "/alerts",
      "targetBlank": true
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "refresh": "30s"
}

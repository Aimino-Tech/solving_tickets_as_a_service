# Broker
RABBITMQ_URL=pyamqp://guest:guest@localhost:5672//

# Result backend
REDIS_URL=redis://localhost:6379/0

# OpenAI (triage)
OPENAI_API_KEY=sk-...
OPENAI_CHEAP_MODEL=gpt-4o-mini

# OpenCode (agent dispatch)
OPENCODE_URL=http://localhost:4096

# E2B (sandbox)

# Broker
RABBITMQ_URL=pyamqp://guest:guest@localhost:5672//

# Result backend
REDIS_URL=redis://localhost:6379/0

# OpenAI (triage)
OPENAI_API_KEY=sk-...
OPENAI_CHEAP_MODEL=gpt-4o-mini

# OpenCode (agent dispatch)
OPENCODE_URL=http://localhost:4096

# E2B (sandbox)
E2B_API_KEY=
E2B_TEMPLATE_ID=stas-default

# GitHub (PR creation)
GITHUB_TOKEN=ghp_...

# Slack (notifications)
SLACK_WEBHOOK_URL=

# Celery
CELERY_WORKER_CONCURRENCY=4
CELERY_BROKER_URL=pyamqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# === Sentry Error Monitoring ===
# Get a DSN at https://sentry.io -> Projects -> Create Project -> Python
SENTRY_DSN=
# Description: Sentry DSN for Celery worker error reporting.
#   Leave empty to disable. Example: https://key@o123.ingest.sentry.io/123

SENTRY_ENVIRONMENT=
# Description: Environment name reported to Sentry. Defaults to "development".

SENTRY_TRACES_SAMPLE_RATE=0.1
# Description: Performance trace sampling rate (0.0 to 1.0).

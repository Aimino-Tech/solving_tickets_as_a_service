{
  "$schema": "https://raw.githubusercontent.com/aimino/syntaro-registry/main/schemas/registry-v1.json",
  "name": "SYNTARO",
  "version": "1.0.0",
  "description": "SYNTARO is an AI-powered GitHub bot that automatically fixes bugs and implements features. Label an issue, get a pull request.",
  "tagline": "Label a GitHub issue. Get a pull request — automatically.",
  "capabilities": {
    "fix_generation": {
      "description": "Automatically investigate codebases, write fixes, add regression tests, and open PRs",
      "input": {
        "type": "GitHub issue or issue description",
        "formats": ["issue_number", "title+body", "repo_url"]
      },
      "output": {
        "type": "Pull request with fix + tests",
        "includes": ["fix implementation", "regression tests", "test suite execution", "PR description"]
      },
      "supported_platforms": ["GitHub", "GitLab (beta)", "Bitbucket (beta)"]
    },
    "job_polling": {
      "description": "Poll fix job status and retrieve detailed results including PR URL and test metrics",
      "polling_method": "REST API with job ID"
    },
    "eval_results": {
      "description": "Public benchmark evaluation results showing pass rates across SWE-bench, HumanEval, XOR, and custom benchmarks",
      "access": "Public (no auth required)"
    },
    "health_monitoring": {
      "description": "Service health checks for uptime monitoring and dependency status",
      "endpoint": "/api/health"
    }
  },

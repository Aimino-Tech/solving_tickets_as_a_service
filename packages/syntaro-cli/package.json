{
  "name": "@aimino-tech/stas",
  "version": "0.1.0",
  "description": "STAS — Solving Tickets As A Service. AI-powered GitHub bot that fixes issues automatically.",
  "type": "module",
  "bin": {
    "stas": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aimino-Tech/solving_tickets_as_a_service.git"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean --dts",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "inquirer": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "open": "^10.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0",
    "@types/inquirer": "^9.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "stas",
    "github",
    "bot",
    "ai",
    "fix",
    "issue",
    "automation"
  ],
  "license": "AGPL-3.0"
}

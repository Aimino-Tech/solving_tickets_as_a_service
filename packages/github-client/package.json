{
  "name": "@stas/github-client",
  "version": "0.1.0",
  "description": "GitHub App client for STAS — auth, PR creation, and structured message templates",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [

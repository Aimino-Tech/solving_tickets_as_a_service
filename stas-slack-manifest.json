{
  "display_information": {
    "name": "STAS",
    "description": "Solving Tickets As A Service — fix GitHub issues on demand"
  },
  "features": {
    "bot_user": {
      "display_name": "STAS",
      "always_online": true
    },
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "slash_commands": [
      {
        "command": "/stas_fix",
        "description": "Submit a fix request to STAS",
        "usage_hint": "[owner/repo] description of the issue",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public",
        "commands",
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "reactions:read",
        "reactions:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://YOUR_STAS_DOMAIN/slack/events",
      "bot_events": [
        "app_mention",
        "message.channels"
      ]
    },
    "interactivity": {
      "request_url": "https://YOUR_STAS_DOMAIN/slack/events",
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false
  }
}

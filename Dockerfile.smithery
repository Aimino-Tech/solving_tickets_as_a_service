# Smithery deployment Dockerfile for STAS MCP server
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy MCP server code
COPY stas_mcp/ ./stas_mcp/
COPY mcp-manifest/ ./mcp-manifest/

# Install Python dependencies
RUN pip install --no-cache-dir "mcp>=1.0.0" httpx

# Expose MCP SSE port
EXPOSE 4095

# Default: run in SSE mode
CMD ["python", "-m", "stas_mcp.server", "sse", "--host", "0.0.0.0", "--port", "4095"]

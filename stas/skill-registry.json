{
  "$schema": "https://opencode.ai/skill-registry.json",
  "version": "1.0.0",
  "skills": [
    {
      "name": "stas",
      "description": "STAS — Solving Tickets As A Service. Submit GitHub issues and get automated fix PRs.",
      "version": "0.2.0",
      "author": "Aimino Tech",
      "license": "MIT",
      "homepage": "https://github.com/Aimino-Tech/solving_tickets_as_a_service",
      "installUrl": "https://raw.githubusercontent.com/Aimino-Tech/solving_tickets_as_a_service/main/skills/stas/SKILL.md",
      "tags": ["github", "automation", "code-review", "pr-creation", "bug-fixing", "mcp"],
      "categories": ["productivity", "developer-tools", "ci-cd"],
      "platforms": ["opencode", "openclaw", "claude-code"],
      "capabilities": {
        "tools": ["submit_issue", "check_status", "get_run_history", "list_repos", "poll_job"],
        "resources": ["stas://runs/{run_id}", "stas://issues/{issue_id}", "stas://jobs/{job_id}"],
        "mcp": {
          "transport": "stdio",
          "command": "python3",
          "args": ["-m", "stas_mcp.server", "stdio"]
        }
      },
      "mcpServers": {
        "stas": {
          "command": "python3",
          "args": ["-m", "stas_mcp.server", "stdio"],
          "env": {
            "STAS_API_KEY": { "description": "STAS API key for authentication", "required": true, "secret": true },
            "STAS_API_URL": { "description": "STAS API base URL", "required": false, "default": "https://api.stas.aimino.io" },
            "GITHUB_TOKEN": { "description": "GitHub personal access token", "required": false, "secret": true }
          }
        }
      }
    }
  ]
}

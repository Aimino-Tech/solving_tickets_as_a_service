{
  "$schema": "https://rapidapi.com/schemas/rapidapi-listing.json",
  "apiName": "STAS API",
  "apiVersion": "1.0.0",
  "description": "STAS (Solving Tickets As A Service) is an AI-powered GitHub bot that automatically fixes issues. Submit a GitHub issue URL, and STAS investigates your codebase, writes a fix, runs regression tests, and opens a PR — fully automated.",
  "tagline": "Label a GitHub issue. Get a pull request — automatically.",
  "logo": "https://stas.aimino.io/logo.png",
  "website": "https://stas.aimino.io",
  "documentationUrl": "https://github.com/tamnguyen08/solving_tickets_as_a_service",
  "supportUrl": "https://github.com/tamnguyen08/solving_tickets_as_a_service/issues",
  "sourceCodeUrl": "https://github.com/tamnguyen08/solving_tickets_as_a_service",
  "categories": ["developer-tools", "ai", "automation"],
  "visibility": "public",
  "requiresApproval": false,
  "pricing": {
    "currency": "USD",
    "billing": {
      "mode": "plan",
      "cycle": "monthly"
    },
    "plans": [
      {
        "name": "Free",
        "description": "Try STAS with limited daily usage. Perfect for evaluation and small projects.",
        "price": 0,
        "requestsPerDay": 10,
        "requestsPerMonth": 300,
        "rateLimit": {
          "requests": 10,
          "period": "1 day"
        },
        "features": [
          "10 fix submissions per day",
          "Job polling and status tracking",
          "Public eval results access",
          "Community support via GitHub Issues"
        ]
      },
      {
        "name": "Pro",
        "description": "For active development teams. Automate your bug fixes daily.",
        "price": 49,
        "requestsPerDay": 100,
        "requestsPerMonth": 3000,
        "rateLimit": {
          "requests": 100,
          "period": "1 day"
        },
        "features": [
          "100 fix submissions per day",
          "Priority job queue",
          "Job polling and status tracking",
          "Email support",
          "Public eval results access"
        ]
      },
      {
        "name": "Enterprise",
        "description": "For high-volume teams and organizations. Scale your automated fix pipeline.",
        "price": 199,
        "requestsPerDay": 1000,
        "requestsPerMonth": 30000,
        "rateLimit": {
          "requests": 1000,
          "period": "1 day"
        },
        "features": [
          "1000 fix submissions per day",
          "Priority job queue",
          "Job polling and status tracking",
          "Premium support (Slack + Email)",
          "Custom integrations",
          "SLA guarantee",
          "Public eval results access",
          "Dedicated onboarding"
        ]
      }
    ]
  },
  "endpoints": {
    "baseUrl": "https://stas-rapidapi.p.rapidapi.com",
    "auth": {
      "type": "header",
      "key": "X-RapidAPI-Key",
      "additionalHeaders": {
        "X-RapidAPI-Proxy-Secret": "Your RapidAPI proxy secret"
      }
    },
    "specs": {
      "openapi": "./openapi.yaml"
    }
  },
  "testEndpoint": "/api/health",
  "keywords": [
    "github",
    "automation",
    "bug-fixing",
    "ai",
    "developer-tools",
    "pull-request",
    "code-review",
    "cicd",
    "issue-tracker",
    "opencode"
  ],
  "screenshots": [
    {
      "title": "Submit a Fix Job",
      "description": "Submit a GitHub issue URL and get a fix PR created automatically",
      "path": "./marketplace-assets/screenshot-submit-fix.png"
    },
    {
      "title": "Job Polling Results",
      "description": "Poll for status and results with a simple job ID",
      "path": "./marketplace-assets/screenshot-job-status.png"
    },
    {
      "title": "Eval Results Dashboard",
      "description": "View STAS benchmark performance and pass rates",
      "path": "./marketplace-assets/screenshot-eval-results.png"
    }
  ],
  "changelog": "https://github.com/tamnguyen08/solving_tickets_as_a_service/blob/main/CHANGELOG.md",
  "termsOfService": "https://github.com/tamnguyen08/solving_tickets_as_a_service/blob/main/LICENSE",
  "privacyPolicy": "https://stas.aimino.io/privacy",
  "sdk": {
    "curl": {
      "example": "curl -X POST https://stas-rapidapi.p.rapidapi.com/api/fix -H \"Content-Type: application/json\" -H \"X-RapidAPI-Key: your-rapidapi-key\" -H \"X-RapidAPI-Proxy-Secret: your-proxy-secret\" -d '{\"repoUrl\":\"https://github.com/owner/repo\",\"issueTitle\":\"Fix login bug\",\"issueBody\":\"Login returns 500\"}'"
    }
  }
}

# === STAS Configuration ===
# All config is via environment variables. Copy this file to .env and fill in.

# === Run Mode ===
# "api" | "worker" | "both" (default: both)
RUN_MODE=both
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# === GitHub App credentials ===
# Create a GitHub App: https://github.com/settings/apps/new
GITHUB_APP_ID=
# Either set the private key path or the key directly:
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# GitHub App webhook path (default: /webhook)
GITHUB_WEBHOOK_PATH=/webhook

# === Worker / Queue (BullMQ + Redis) ===
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2
QUEUE_DEDUP_TTL_SECONDS=120
QUEUE_KEEP_COMPLETED=200
QUEUE_KEEP_FAILED=100

# === OpenCode Serve ===
OPENCODE_URL=http://localhost:4096
OPENCODE_MODEL=anthropic/claude-sonnet-4-20250514

# === OpenAI (for cheap triage/classification) ===
OPENAI_API_KEY=
OPENAI_CHEAP_MODEL=gpt-4o-mini

# === E2B Sandbox ===
# Get your API key: https://e2b.dev
E2B_API_KEY=
E2B_TEMPLATE_ID=stas-default
E2B_SANDBOX_TIMEOUT_MS=300000

# === STAS Bot Settings ===
STAS_LABEL=stas:fix
BOT_NAME=STAS
MAX_AGENT_ITERATIONS=40
MAX_ISSUE_COMMENTS=15

# === Development ===
DEV_SKIP_WEBHOOK_SIGNATURE_VERIFY=false

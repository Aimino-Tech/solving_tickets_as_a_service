# =============================================================================
# STAS -- Solving Tickets As A Service
# Configuration via environment variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required variables are marked with (REQUIRED).
# All others have sensible defaults and can be left commented out.
# =============================================================================

# === Run Mode ===
STAS_AI_MODE=ai
# Description: AI mode for the bot -- "ai" (real AI) or "static" (deterministic
#   placeholder responses). Set to "static" to test the full application flow
#   (webhooks, queue, dispatch, PR creation) without consuming AI tokens.
#   In static mode, all agent responses are mock/dummy data.
STAS_AI_MODE_VALUES=ai | static

# --- AI-Disabled Mode ---
STAS_AI_DISABLED=false
# Description: When true, STAS runs in AI-disabled mode. Webhooks are accepted
#   and queued as pending, but no dispatch to OpenCode occurs. Operators must
#   manually claim and complete issues via the admin API. Useful for manual
#   infrastructure operation without an AI agent attached.
#   Default: false (AI agent active)
#   When true, all webhooks go to pending state automatically.

RUN_MODE=both
# Description: How to start the bot -- "api" (webhook server only),
#   "worker" (job processor only), or "both" (default).
RUN_MODE_VALUES=both | api | worker

PORT=3000
# Description: HTTP port for the webhook server. Default: 3000

NODE_ENV=development
# Description: Environment name. Controls logging, error handling, and
#   other runtime behavior. Default: development
NODE_ENV_VALUES=development | production

# === Logging ===
LOG_LEVEL=info
# Description: Verbosity of log output. Default: info
LOG_LEVEL_VALUES=debug | info | warn | error

ADMIN_API_KEY=
# Description: API key for the admin API. All /admin/* endpoints require
#   this key in the Authorization header as a Bearer token.
#   If not set, admin endpoints return 503.
#   Example: ADMIN_API_KEY=stas-admin-secret-key-123

# =============================================================================
# GitHub App -- (REQUIRED) Create one at https://github.com/settings/apps/new
# =============================================================================
# 1. Go to https://github.com/settings/apps/new
# 2. Set Webhook URL to https://your-domain.com/webhook
# 3. Set Webhook secret (copy to GITHUB_WEBHOOK_SECRET below)
# 4. Set permissions: Issues (read+write), Pull Requests (write), Contents (write)
# 5. Subscribe to: Issues, Issue comments, Pull requests
# 6. Generate a private key (download the PEM file)
# =============================================================================

GITHUB_APP_ID=
# Description: (REQUIRED) GitHub App ID from the app settings page.
#   Looks like a numeric ID (e.g., 123456).
#   Find it at: https://github.com/settings/apps/<your-app>

# --- Private Key (choose ONE of two options) ---

GITHUB_APP_PRIVATE_KEY_PATH=
# Description: Path to the GitHub App private key PEM file on disk.
#   Example: /etc/stas/app-private-key.pem
#   Alternative: set GITHUB_APP_PRIVATE_KEY with the key content instead.

GITHUB_APP_PRIVATE_KEY=
# Description: GitHub App private key content (inline). Use this OR the
#   path option above, not both. If using a .env file, replace newlines
#   with literal \n characters or wrap the value in single quotes.
#   Example:
#     GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpA...\n-----END RSA PRIVATE KEY-----"

GITHUB_WEBHOOK_SECRET=
# Description: (REQUIRED) Webhook secret configured in your GitHub App
#   settings. Used to verify that incoming webhooks are genuinely from GitHub.

GITHUB_WEBHOOK_PATH=/webhook
# Description: URL path for the webhook endpoint. Default: /webhook
#   Must match the Webhook URL path in your GitHub App settings.

# =============================================================================
# Queue -- RabbitMQ (AMQP) backed with Redis for caching
# =============================================================================

QUEUE_BACKEND=amqp
# Description: Queue backend to use. Only "amqp" (RabbitMQ) is supported.
#   Default: amqp

RABBITMQ_URL=amqp://guest:guest@localhost:5672/stas
# Description: RabbitMQ (AMQP) connection URL.
#   Default: amqp://guest:guest@localhost:5672/stas
#   Supports amqp:// and amqps:// (TLS) URIs.

REDIS_URL=redis://localhost:6379
# Description: Redis connection URL for caching and session storage.
#   Default: redis://localhost:6379

WORKER_CONCURRENCY=2
# Description: Number of jobs a single worker processes concurrently.
#   Default: 2

QUEUE_DEDUP_TTL_SECONDS=120
# Description: Time-to-live in seconds for deduplication keys. Prevents
#   the same issue from being queued twice within this window. Default: 120

QUEUE_MAX_RETRIES=4
# Description: Maximum number of retry attempts for failed jobs before they
#   are moved to the dead-letter queue. Default: 4. Max: 10

QUEUE_RETRY_DELAYS=30000,120000,300000,900000
# Description: Comma-separated list of retry delays in milliseconds.
#   Each position corresponds to the delay before retry attempt N.
#   Default: 30000,120000,300000,900000 (30s, 2min, 5min, 15min)
#   After max retries, the job moves to the dead-letter queue.


# =============================================================================
# Health & Monitoring -- Queue depth thresholds, DLQ retention, alerting
# =============================================================================
# These settings control the /health/queue endpoint, scheduled maintenance
# tasks, and the Prometheus /metrics endpoint.
# =============================================================================

HEALTH_QUEUE_DEPTH_WARN_THRESHOLD=50
# Description: Queue depth at which a warning status is reported in /health/queue.
#   Default: 50 messages

HEALTH_QUEUE_DEPTH_CRIT_THRESHOLD=200
# Description: Queue depth at which a critical status is reported in /health/queue.
#   Triggers 503 HTTP status and alerts. Default: 200 messages

HEALTH_QUEUE_DEPTH_ALERT_MINUTES=5
# Description: How often (in minutes) the scheduled queue depth check runs.
#   Default: 5 minutes

DLQ_RETENTION_DAYS=7
# Description: Number of days to retain messages in the dead-letter queue
#   before they are eligible for cleanup. Default: 7 days

# =============================================================================
# Alerting -- Thresholds for Slack/notification alerts
# =============================================================================

ALERT_SLACK_CHANNEL=#stas-alerts
# Description: Slack channel to send queue/DLQ alerts to.
#   Default: #stas-alerts

ALERT_WARN_QUEUE_DEPTH=50
# Description: Warning queue depth threshold for Slack alerts.
#   Default: 50 messages

ALERT_CRIT_QUEUE_DEPTH=200
# Description: Critical queue depth threshold for Slack alerts.
#   Default: 200 messages

ALERT_WARN_ERROR_RATE_PERCENT=10
# Description: Warning threshold for error rate as a percentage of total jobs.
#   Default: 10%

ALERT_CRIT_ERROR_RATE_PERCENT=30
# Description: Critical threshold for error rate as a percentage of total jobs.
#   Default: 30%
# =============================================================================
# OpenCode Serve -- The coding agent that investigates and fixes issues
# =============================================================================
# Run OpenCode serve in a separate terminal or container:
#   opencode serve --port 4096
# =============================================================================

OPENCODE_URL=http://localhost:4096
# Description: URL of the OpenCode serve endpoint. Default: http://localhost:4096
#   In production, point this at your OpenCode instance (e.g., internal Docker
#   network URL or a cloud-hosted endpoint).

OPENCODE_MODEL=anthropic/claude-sonnet-4-20250514
# Description: Model identifier for OpenCode agent runs.
#   Format: <provider>/<model-name>. Default: claude-sonnet-4
#   Examples:
#     anthropic/claude-sonnet-4-20250514
#     openai/gpt-4o
#     deepseek/deepseek-coder

FALLBACK_MODELS=gpt-4o,claude-haiku
# Description: Comma-separated list of fallback models to try if the primary
#   model (OPENCODE_MODEL) fails. Each model is tried in order until one
#   succeeds or the list is exhausted. Default: gpt-4o,claude-haiku

# =============================================================================
# Triage LLM -- Cheap model for issue classification before the fix agent runs
# =============================================================================
# The triage step categorizes incoming issues (bug, feature, question) and
# estimates scope. This is a cheaper, faster model to filter out noise before
# spending money on a full agent run.
# =============================================================================

OPENAI_API_KEY=
# Description: API key for the triage/classification LLM. Optional but
#   recommended -- without it, all labeled issues pass through to the agent
#   without classification.

OPENAI_CHEAP_MODEL=gpt-4o-mini
# Description: Model name for issue classification. Default: gpt-4o-mini
#   Choose a cheap, fast model since this is just for triage.
#   Examples: gpt-4o-mini, deepseek-chat, claude-3-haiku

# =============================================================================
# E2B Sandbox -- Isolated environment for code execution
# =============================================================================
# Every fix runs in an E2B cloud sandbox. This prevents untrusted code from
# touching your system. Get an API key at https://e2b.dev
# =============================================================================

E2B_API_KEY=
# Description: API key for E2B cloud sandbox. Optional for local dev; required for production.
#   Get one at https://e2b.dev -- the free tier is sufficient for development.

E2B_TEMPLATE_ID=stas-default
# Description: E2B sandbox template ID. Default: stas-default
#   Templates define the base environment (OS, tools, dependencies) for
#   sandboxed code execution.

E2B_SANDBOX_TIMEOUT_MS=300000
# Description: Maximum execution time for a sandboxed run in milliseconds.
#   Default: 300000 (5 minutes). Increase for repos with long test suites.
#   Maximum recommended: 600000 (10 minutes).

# =============================================================================
# STAS Bot Settings
# =============================================================================

STAS_LABEL=stas:fix
# Description: Issue label that triggers the bot. When someone adds this
#   label to an issue, STAS picks it up. Default: stas:fix
#   Change this to avoid conflicts with other bots.

BOT_NAME=STAS
# Description: Name the bot uses in issue comments and PR descriptions.
#   Default: STAS. Change if you run multiple instances.

# =============================================================================
# STAS Limits & Tuning
# =============================================================================

MAX_AGENT_ITERATIONS=40
# Description: Maximum tool-call iterations for the OpenCode agent per fix
#   run. Higher values let the agent work through complex issues but cost
#   more. Default: 40

MAX_ISSUE_COMMENTS=15
# Description: Maximum number of issue comments the agent will post during
#   a run (status updates, questions, etc.). Prevents spam on high-traffic
#   issues. Default: 15

# =============================================================================
# Slack Notifications -- Receive STAS status updates in Slack
# =============================================================================
# Create an incoming webhook at https://api.slack.com/messaging/webhooks
# Then set SLACK_WEBHOOK_URL to the webhook URL.
# Leave SLACK_WEBHOOK_URL unset to disable Slack notifications.
# =============================================================================

SLACK_WEBHOOK_URL=
# Description: Slack incoming webhook URL for simple text notifications.
#   Create one at https://api.slack.com/messaging/webhooks
#   Example: https://hooks.slack.com/services/T00000000/B00000000/xxxxxxxx
#   Leave empty to disable Slack webhook notifications.

SLACK_CHANNEL=
# Description: Optional Slack channel override (e.g., #stas-alerts).
#   If empty, uses the default channel configured in the webhook/Bolt settings.

# =============================================================================
# Slack Bolt SDK -- Interactive messages (buttons, modals, actions)
# =============================================================================
# For interactive message features, create a Slack app at
# https://api.slack.com/apps and add a Bot Token with the
# chat:write and chat:write.public scopes.
# =============================================================================

SLACK_BOT_TOKEN=
# Description: Slack Bot User OAuth Token (starts with xoxb-).
#   Required for interactive Block Kit messages with buttons.
#   Create at: https://api.slack.com/apps -> OAuth & Permissions.
#   Scopes needed: chat:write, chat:write.public, commands
#   Leave empty to use webhook-only mode (no interactivity).

SLACK_SIGNING_SECRET=
# Description: Slack signing secret for verifying interactive request
#   payloads. Found in your Slack app settings under "Basic Information".
#   Required when SLACK_BOT_TOKEN is set.

SLACK_INTERACTIONS_PATH=/slack/events
# Description: HTTP path for Slack interactive event callbacks.
#   Must match the Request URL in your Slack app's Interactivity
#   and Events settings. Default: /slack/events

# =============================================================================
# Development
# =============================================================================

DEV_SKIP_WEBHOOK_SIGNATURE_VERIFY=false
# Description: Skip GitHub webhook signature verification. Set to true
#   during local development when testing with smee.io or similar.
#   NEVER enable in production. Default: false
DEV_SKIP_VALUES=true | false

# SMEE_URL=https://smee.io/your-channel-id
# Description: (Development only) smee.io URL for forwarding GitHub
#   webhooks to your local machine. Start the smee client:
#     npx smee --url https://smee.io/your-channel-id --path /webhook --port 3000

# =============================================================================
# Linear Integration -- Issue tracker sync (Phase 5)
# =============================================================================
# Configure Linear integration to sync tickets into the STAS queue.
# Get an API key at https://linear.app/settings/api
# =============================================================================

LINEAR_API_KEY=
# Description: Linear API key for fetching issue details and posting comments.
#   Required to enable Linear integration. Get one at https://linear.app/settings/api

LINEAR_WEBHOOK_SECRET=
# Description: Secret for verifying Linear webhook payloads.
#   Configure in Linear -> Settings -> Webhooks -> Create webhook.
#   The webhook URL should be: https://your-domain.com/webhook/linear

# =============================================================================
# Jira Integration -- Issue tracker sync (Phase 5)
# =============================================================================
# Configure Jira integration to sync tickets into the STAS queue.
# Create an API token at https://id.atlassian.com/manage/api-tokens
# =============================================================================

JIRA_URL=
# Description: (REQUIRED for Jira) Base URL of your Jira instance.
#   Example: https://your-domain.atlassian.net

JIRA_EMAIL=
# Description: (REQUIRED for Jira) Email address for Jira authentication.
#   Must match the email of the user who created the API token.

JIRA_API_TOKEN=
# Description: (REQUIRED for Jira) Jira API token for authentication.
#   Create one at https://id.atlassian.com/manage/api-tokens

JIRA_WEBHOOK_SECRET=
# Description: Secret for verifying Jira webhook payloads.
#   Configure in Jira -> System -> Webhooks -> Create webhook.
#   The webhook URL should be: https://your-domain.com/webhook/jira

JIRA_PROJECT_KEY=
# Description: Default Jira project key to filter incoming webhook events.
#   Example: PROJ

# =============================================================================
# Tracker-to-GitHub Repo Mapping
# =============================================================================
# When a ticket arrives from Linear or Jira, STAS needs to know which GitHub
# repo to clone and which GitHub App installation to use.
# =============================================================================

TRACKER_DEFAULT_REPO_OWNER=
# Description: Default GitHub repo owner for tracker-sourced tickets.
#   Example: my-org

TRACKER_DEFAULT_REPO_NAME=
# Description: Default GitHub repo name for tracker-sourced tickets.
#   Example: my-repo

TRACKER_INSTALLATION_ID=
# Description: GitHub App installation ID to use for tracker-sourced tickets.
#   Find this in your GitHub App settings -> Advanced -> Installations.

# =============================================================================
# Stripe -- Credit Purchase Flow
# =============================================================================
# To enable credit purchases, create a Stripe account at https://stripe.com
# and set up products and prices in the Stripe Dashboard.
#
# 1. Create three products: 100 Credits, 500 + 50 Bonus, 2000 + 200 Bonus
# 2. Create corresponding prices (one-time) for each product
# 3. Copy the Price IDs (e.g., price_abc123) to STRIPE_PRICE_* vars
# 4. Set STRIPE_SECRET_KEY to your Stripe secret key (starts with sk_live_ or sk_test_)
# 5. Set STRIPE_WEBHOOK_SECRET to the webhook signing secret from:
#    Stripe Dashboard -> Developers -> Webhooks -> Add endpoint
#    The endpoint URL should be: https://your-domain.com/webhook/stripe
# =============================================================================

STRIPE_SECRET_KEY=
# Description: (REQUIRED for Stripe) Your Stripe secret key.
#   Starts with sk_live_ (production) or sk_test_ (test mode).
#   Get it at: https://dashboard.stripe.com/apikeys
#   Leave empty to disable Stripe credit purchases.

STRIPE_WEBHOOK_SECRET=
# Description: (REQUIRED for Stripe) Webhook signing secret for verifying
#   Stripe webhook payloads. Configure in Stripe Dashboard -> Developers ->
#   Webhooks. The endpoint secret is generated when you create a webhook
#   endpoint pointing to https://your-domain.com/webhook/stripe

STRIPE_PRICE_100_CREDITS=price_100credits
# Description: Stripe Price ID for the 100 Credits pack ($10.00).
#   Default: price_100credits (placeholder -- replace with your actual Price ID)

STRIPE_PRICE_500_CREDITS=price_500credits
# Description: Stripe Price ID for the 500 + 50 Bonus Credits pack ($45.00).
#   Default: price_500credits (placeholder -- replace with your actual Price ID)

STRIPE_PRICE_2000_CREDITS=price_2000credits
# Description: Stripe Price ID for the 2000 + 200 Bonus Credits pack ($150.00).
#   Default: price_2000credits (placeholder -- replace with your actual Price ID)

STRIPE_PRICE_SOLO=price_solo_monthly
# Description: Stripe Price ID for the Solo plan ($49/mo, 100 fixes).
#   Default: price_solo_monthly (placeholder -- replace with your actual Price ID)

STRIPE_PRICE_TEAM=price_team_monthly
# Description: Stripe Price ID for the Team plan ($149/mo, 500 fixes).
#   Default: price_team_monthly (placeholder -- replace with your actual Price ID)

# =============================================================================
# Database — PostgreSQL connection
# =============================================================================
# STAS uses PostgreSQL. DATABASE_URL is the primary connection string.
#
# Connection pool:
#   DATABASE_POOL_MIN — minimum idle connections (default: 2)
#   DATABASE_POOL_MAX — maximum connections in pool (default: 10)
#
# SSL:
#   Set DATABASE_SSL=true for production (e.g., Railway, Fly.io, RDS).
#   The pool uses rejectUnauthorized=true when SSL is enabled.
#
# Examples:
#   DATABASE_URL=postgres://user:password@localhost:5432/stas
#   DATABASE_URL=postgres://user:password@host:5432/stas?sslmode=require
# =============================================================================

DATABASE_URL=postgres://localhost:5432/stas
# Description: PostgreSQL connection URL. Default: postgres://localhost:5432/stas
#   Supports all valid postgres:// connection URIs.
#   Examples:
#     postgres://user:pass@localhost:5432/stas
#     postgres://user:pass@host:5432/stas?sslmode=require
#     postgres://user:pass@aws-rds-host:5432/stas

DATABASE_POOL_MIN=2
# Description: Minimum number of idle connections to maintain in the pool.
#   Default: 2. Increase for high-traffic deployments.

DATABASE_POOL_MAX=10
# Description: Maximum number of connections in the pool.
#   Default: 10. Match this to your database's max_connections setting.
#   Railway free tier: ~15 connections. Production: 20-50.

DATABASE_SSL=false

DATABASE_ENABLE_AUDIT_PERSISTENCE=false
# Description: When true, audit log entries are persisted to the audit_logs table.
#   Default: false. Set to true in production to enable database audit persistence.
# Description: Enable SSL for database connections.
#   Default: false. Set to true for production (Railway, Fly.io, RDS, etc.).
#   Uses rejectUnauthorized=true for secure connections.

# =============================================================================
# Security Configuration
# =============================================================================

# === IP Allowlist for Webhook Endpoints ===
# When enabled, only requests from the specified IPs/CIDR ranges can access
# webhook endpoints. This is an additional layer of security on top of
# webhook signature verification.
# GitHub webhook IPs: https://api.github.com/meta (hooks key)
# GitLab webhook IPs: https://about.gitlab.com/security/#ip-range
# Stripe webhook IPs: https://stripe.com/docs/webhooks/setup#ip-whitelist

IP_ALLOWLIST_ENABLED=false
# Description: Enable IP allowlist for webhook endpoints. Default: false
#   When enabled without IP_ALLOWLIST, only localhost is allowed.

IP_ALLOWLIST=
# Description: Comma-separated list of IPs or CIDR ranges allowed to access
#   webhook endpoints. Example: 192.30.252.0/22,185.199.108.0/22,140.82.112.0/20
#   Leave empty to only allow localhost (when IP_ALLOWLIST_ENABLED=true).

# === Request Size Limits ===
# Prevents denial-of-service attacks via large payloads

REQUEST_BODY_LIMIT=1mb
# Description: Maximum size for API request bodies (non-webhook endpoints).
#   Default: 1mb. Set to a larger value if you have custom integrations.

WEBHOOK_BODY_LIMIT=5mb
# Description: Maximum size for webhook payload bodies.
#   Default: 5mb. GitHub/GitLab webhooks are typically under 1mb but
#   some providers may send larger payloads.

# === Docker Sandbox Settings ===
# The Docker sandbox runs fix code in an isolated container. These settings
# control the container's security posture: resource limits, network access,
# seccomp/AppArmor profiles, and the container runtime (runc vs gVisor).
#
# Default base image: ubuntu:24.04
# Default runtime: runc (switch to gVisor for kernel-level isolation)

DOCKER_IMAGE=ubuntu:24.04
# Description: Base Docker image for the sandbox container.
#   Should be a minimal image with Node.js available.
#   Default: ubuntu:24.04

DOCKER_NETWORK_RESTRICT=true
# Description: When true, sandbox network is restricted via iptables rules
#   or Squid egress proxy to only allowed hosts. When false, no network
#   restriction is applied. Default: true

DOCKER_ALLOWED_HOSTS=api.github.com,github.com,raw.githubusercontent.com,registry.npmjs.org,pypi.org,files.pythonhosted.org,proxy.golang.org,index.crates.io,crates.io
# Description: Comma-separated list of hosts the sandbox is allowed to
#   connect to when DOCKER_NETWORK_RESTRICT is enabled.

DOCKER_CONTAINER_MEMORY=4g
# Description: Memory limit per sandbox container. Default: 4g

DOCKER_CONTAINER_CPU=2
# Description: CPU limit per sandbox container (number of cores). Default: 2

DOCKER_SECCOMP_PROFILE=./docker/seccomp/sandbox.json
# Description: Path to the seccomp profile JSON file used to filter
#   syscalls inside the sandbox container. Default: ./docker/seccomp/sandbox.json

DOCKER_APPARMOR_PROFILE=stas-sandbox
# Description: Name of the AppArmor profile to apply to sandbox containers.
#   The profile must be loaded on the host before containers are created.
#   Default: stas-sandbox

DOCKER_GVISOR_ENABLED=false
# Description: When true, sandbox containers use gVisor (runsc) runtime
#   instead of default runc for kernel-level isolation. Requires gVisor
#   to be installed on the host. Default: false

# === Sandbox Security ===
# These settings control the security posture of the E2B/Docker sandbox
# where fix code is executed.

SANDBOX_PRIVILEGED=false
# Description: Never set to true. Running sandboxes with --privileged
#   mode gives them full access to the host system.

SANDBOX_READONLY_ROOT=true
# Description: Make sandbox root filesystem read-only. Prevents
#   persistent modifications to the sandbox environment.

SANDBOX_MEMORY_LIMIT=512m
# Description: Maximum memory per sandbox. Default: 512m

SANDBOX_CPU_LIMIT=0.5
# Description: CPU limit per sandbox. Default: 0.5 (half a core)

SANDBOX_PIDS_LIMIT=256
# Description: Maximum number of processes per sandbox. Prevents
#   fork bomb attacks. Default: 256

SANDBOX_DISK_LIMIT=2gb
# Description: Maximum disk space per sandbox. Default: 2gb

SANDBOX_NETWORK_ENABLED=false
# Description: Allow sandbox to access the network. When false, the
#   sandbox is fully network-isolated. Set to true only if the fix
#   process requires internet access (e.g., npm install).
#   Default: false

# === Admin API ===

ADMIN_API_KEY=
# Description: Shared API key for admin endpoints (/admin/*).
#   Generate a strong random key. Example:
#     openssl rand -hex 32
#   Leave empty to disable admin endpoints.

CORS_ORIGIN=*
# Description: CORS origin for the Express server. Default: *
#   Set to your frontend domain in production:
#     https://dashboard.stas.dev
#   Or multiple origins (comma-separated):
#     https://app.stas.dev,https://admin.stas.dev

# =============================================================================
# Webhook Retry Worker — Exponential backoff for failed webhook deliveries
# =============================================================================
# The retry worker polls for failed webhook events and re-processes them
# with exponential backoff: 1min, 5min, 30min (max 3 retries).
# The /admin/webhooks endpoints provide manual replay capabilities.
# =============================================================================

WEBHOOK_RETRY_POLL_INTERVAL_MS=15000
# Description: How often the retry worker polls for stale events (ms).
#   Default: 15000 (15 seconds). Lower values = faster retries but more DB load.

WEBHOOK_RETRY_BATCH_SIZE=10
# Description: Maximum number of stale events to process per poll cycle.
#   Default: 10. Higher values clear backlogs faster but increase DB pressure.

# =============================================================================
# Django — Web app + Admin API (runs alongside Express during migration)
# =============================================================================
# STAS includes a Django app that receives webhooks and provides an admin API.
# During the migration phase, both the Express (port 3000) and Django (port 8000)
# servers run in parallel. Django handles new webhook flows via Celery tasks.
# =============================================================================

DJANGO_DEBUG=true
# Description: Enable Django debug mode. Set to false in production.
#   Default: true in development, false in production.

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Description: Comma-separated list of allowed host/domain names for Django.
#   Default: localhost,127.0.0.1,0.0.0.0
#   In production, add your domain: stas.yourdomain.com

DJANGO_SECRET_KEY=
# Description: Django secret key for cryptographic signing.
#   Generate a strong key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#   If not set, a development-only fallback key is used (do NOT use in production).

# =============================================================================
# RabbitMQ — Message broker for Celery task queue
# =============================================================================
# RabbitMQ replaces BullMQ as the primary task queue. Celery workers consume
# tasks from dedicated RabbitMQ queues for each pipeline stage (triage,
# dispatch, sandbox, verification, PR creation, notifications).
# =============================================================================

CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
# Description: RabbitMQ connection URL for Celery.
#   Default: amqp://guest:guest@localhost:5672//
#   In Docker: amqp://guest:guest@stas-rabbitmq:5672//
#   Format: amqp://user:password@host:port/vhost

CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Description: Redis URL for Celery task result storage.
#   Default: redis://localhost:6379/0
#   In Docker: redis://stas-redis:6379/0

# === Worker Configuration ===

CELERY_TASK_SOFT_TIME_LIMIT=580
# Description: Soft time limit for Celery tasks in seconds.
#   Task receives a SoftTimeLimitExceeded exception at this threshold.
#   Default: 580

CELERY_TASK_HARD_TIME_LIMIT=600
# Description: Hard time limit for Celery tasks in seconds.
#   Worker terminates the task process at this threshold.
#   Default: 600

WORKER_CONCURRENCY=2
# Description: Number of Celery worker processes to run.
#   Default: 2. Increase for more parallelism.

# === Celery Queues ===
# Pre-defined queues (configured in settings.py):
#   stas.agents.triage        — Issue classification
#   stas.agents.dispatch      — OpenCode agent execution
#   stas.agents.sandbox       — E2B sandbox environment
#   stas.agents.verification  — Test suite verification
#   stas.agents.pr_creation   — GitHub PR creation
#   stas.agents.notifications — Slack/webhook notifications
#   stas.agents.default       — Default fallback queue

# === Flower (Celery Monitor) ===
# Available at http://localhost:5555 when running with Docker Compose.
# No additional configuration required.

# === Data Processing Agreement (DPA) ===
# DPA_VERSION=2026-06-01
# Version identifier for the DPA. Bumping this requires re-acceptance.
# DPA_REQUIRE_ACCEPTANCE=true
# Whether to require DPA acceptance before creating a checkout session.
# DATA_RETENTION_DAYS=30
# Number of days to retain data after subscription cancellation before purging.

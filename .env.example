# ═══════════════════════════════════════════════
# SYNTARO — Production Environment Configuration
# ═══════════════════════════════════════════════

# ── Server ────────────────────────────────────
PORT=3000
NODE_ENV=production
RUN_MODE=api
LOG_LEVEL=info
SYNTARO_LABEL=syntaro:fix
SYNTARO_AI_DISABLED=true
SYNTARO_PUBLIC_URL=https://syntaro.aimino.io
# Show "Powered by SYNTARO" footer with tracked ?ref= link on PRs and issue comments
SYNTARO_POWERED_BY_FOOTER=true

# ── JWT Auth ─────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# ── Database (Supabase PostgreSQL) ────────────
SUPABASE_URL=https://your-project.supabase.co
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL=true
DATABASE_ENABLE_AUDIT_PERSISTENCE=true

# ── Redis ──────────────────────────────────────
REDIS_URL=redis://:password@localhost:6379

# ── OpenSymphony Dispatch (thin router mode) ──
# When set, SYNTARO forwards GitHub issues to OpenSymphony instead of running
# its own agent pipeline. Unset to keep using the local queue + agent pipeline.
OS_DISPATCH_URL=http://opensymphony:4000/api/v1/dispatch
OS_API_KEY=

# ── RabbitMQ ──────────────────────────────────
RABBITMQ_URL=amqp://user:password@rabbitmq:5672

# ── Linear ─────────────────────────────────────
LINEAR_API_KEY=lin_your_key_here

# ── GitHub App ────────────────────────────────
# Get these from: https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Or use token:
GITHUB_TOKEN=

# ── Stripe ─────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_100_CREDITS=
STRIPE_PRICE_500_CREDITS=
STRIPE_PRICE_2000_CREDITS=

# ── Slack ──────────────────────────────────────
# Get from: https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=

# ── Sentry ─────────────────────────────────────
SENTRY_DSN=

# ── n8n Workflow Automation ────────────────────
# n8n database password (used in docker-compose)
N8N_DB_PASSWORD=
# n8n encryption key (generate: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=
# n8n API key for programmatic workflow management
N8N_API_KEY=
# n8n health check schedule trigger fallback (for webhook-based trigger)
N8N_HEALTHCHECK_WEBHOOK_URL=

# ── PagerDuty ──────────────────────────────────
# Get from: https://your-org.pagerduty.com/integrations
PD_INTEGRATION_KEY=
PD_ESCALATION_POLICY_ID=

# ── Loops (CRM) ────────────────────────────────
LOOPS_API_KEY=

# ── Crisp (Live Chat) ──────────────────────────
# Get from: https://app.crisp.chat/website/settings/websites/
CRISP_WEBSITE_ID=

# ── Plausible (Analytics) ─────────────────────
# Already configured in website/index.html
# Domain: syntaro.aimino.io

# ── Agent Provider ───────────────────────────
# OPENCODE_PROVIDER=opensymphony      # 'opensymphony' (default) or 'opencode' (legacy)
# OPENCODE_URL=http://localhost:4096   # Agent serve URL
# OPENCODE_MODEL=gpt-4o               # Model for agent provider
# FREE_TIER_MODEL=free-tier           # Model for free-tier users (via llm-governance)
# FREE_TIER_BASE_URL=http://localhost:4002  # Base URL for free-tier llm-governance proxy
# PAID_TIER_MODEL=deepseek-v4-flash   # Model for paid-tier users
# PAID_TIER_BASE_URL=http://localhost:4002  # Base URL for paid-tier llm-governance proxy

# ── OpenSymphony API (opensymphony provider) ──
# OS_API_URL=http://opensymphony:4000
# OS_API_KEY=

# ── OpenSymphony Dispatch (Node.js dispatcher) ──
# Used by dispatchToOpenSymphony() in osDispatch.ts for HTTP fallback
OPEN_SYMPHONY_DISPATCH_URL=http://symphony-orchestrator:4001/api/v1/events/github
OPEN_SYMPHONY_API_KEY=
OPEN_SYMPHONY_TENANT=default

# ── Governance Proxy ────────────────────────────
# When enabled, SYNTARO dispatches fix jobs through the governance proxy
# (llm-governance) before they reach the agent pipeline.
GOVERNANCE_ENABLED=false
GOVERNANCE_URL=http://llm-governance:4002
GOVERNANCE_TIMEOUT_MS=15000
GOVERNANCE_API_KEY=

# n8n webhook URL for Stripe billing events (AIM-3340)
N8N_STRIPE_WEBHOOK_URL=


# ── Bitbucket (AIM-4630) ────────────────────────
# Bitbucket Marketplace-app OAuth2 credentials used by the SYNTARO Bitbucket
# platform client (client-credentials grant, see docs/platforms/bitbucket-setup.md).
# The app is installed from the Atlassian Marketplace; these are the app's
# client id/secret shown in the vendor portal.
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
# Workspace the instance is connected to (also settable from the dashboard).
BITBUCKET_WORKSPACE=
# Shared secret verifying Bitbucket webhook payloads (HMAC-SHA256, X-Hub-Signature).
# Must match the secret configured on the repo webhook URL: <SYNTARO_PUBLIC_URL>/webhook/bitbucket
BITBUCKET_WEBHOOK_SECRET=
# Defaults to https://api.bitbucket.org — override for Bitbucket Server/Data Center.
BITBUCKET_BASE_URL=
# OAuth2 token endpoint for the client-credentials grant (Bitbucket Cloud default).
BITBUCKET_TOKEN_URL=https://bitbucket.org/site/oauth2/access_token


# ── n8n Onboarding Email Webhook ─────────────────
# This is the n8n webhook URL for sending welcome + credits emails
# when a tenant completes the onboarding wizard.
N8N_ONBOARDING_WEBHOOK_URL=

# ── Admin Steering (AIM-4617) ───────────────────
# Dashboard emails allowed to use /api/v1/admin/steering/* (comma-separated).
# The steering proxy requires a valid dashboard JWT whose email is in this list.
ADMIN_EMAILS=
# OpenSymphony Elixir admin API — forward target for the steering proxy.
# Example: http://symphony:4098
OS_ADMIN_API_URL=
# x-api-key credential sent to the OS admin API. Must be one of the keys in
# SYMPHONY_API_KEYS on the OpenSymphony side (see OS router :api_auth pipeline).
OS_ADMIN_API_KEY=
# Request timeout for forwarded OS admin calls.
OS_ADMIN_TIMEOUT_MS=15000

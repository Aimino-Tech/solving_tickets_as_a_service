# ═══════════════════════════════════════════════
# STAS — Production Environment Configuration
# ═══════════════════════════════════════════════

# ── Server ────────────────────────────────────
PORT=3000
NODE_ENV=production
RUN_MODE=api
LOG_LEVEL=info
STAS_LABEL=stas:fix
STAS_AI_DISABLED=true
STAS_PUBLIC_URL=https://stas.aimino.io

# ── JWT Auth ─────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# ── Database (Supabase PostgreSQL) ────────────
SUPABASE_URL=https://your-project.supabase.co
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL=true
DATABASE_ENABLE_AUDIT_PERSISTENCE=true

# ── Redis ──────────────────────────────────────
REDIS_URL=redis://:password@localhost:6379

# ── OpenSymphony Dispatch (thin router mode) ──
# When set, STAS forwards GitHub issues to OpenSymphony instead of running
# its own agent pipeline. Unset to keep using the local queue + agent pipeline.
OS_DISPATCH_URL=http://opensymphony:4000/api/v1/dispatch
OS_API_KEY=

# ── RabbitMQ ──────────────────────────────────
RABBITMQ_URL=amqp://user:password@rabbitmq:5672

# ── Linear ─────────────────────────────────────
LINEAR_API_KEY=lin_your_key_here

# ── GitHub App ────────────────────────────────
# Get these from: https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Or use token:
GITHUB_TOKEN=

# ── Stripe ─────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_100_CREDITS=
STRIPE_PRICE_500_CREDITS=
STRIPE_PRICE_2000_CREDITS=

# ── Slack ──────────────────────────────────────
# Get from: https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=

# ── Sentry ─────────────────────────────────────
SENTRY_DSN=

# ── n8n Workflow Automation ────────────────────
# n8n database password (used in docker-compose)
N8N_DB_PASSWORD=
# n8n encryption key (generate: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=
# n8n API key for programmatic workflow management
N8N_API_KEY=
# n8n health check schedule trigger fallback (for webhook-based trigger)
N8N_HEALTHCHECK_WEBHOOK_URL=

# ── PagerDuty ──────────────────────────────────
# Get from: https://your-org.pagerduty.com/integrations
PD_INTEGRATION_KEY=
PD_ESCALATION_POLICY_ID=

# ── Loops (CRM) ────────────────────────────────
LOOPS_API_KEY=

# ── Crisp (Live Chat) ──────────────────────────
# Get from: https://app.crisp.chat/website/settings/websites/
CRISP_WEBSITE_ID=

# ── Plausible (Analytics) ─────────────────────
# Already configured in website/index.html
# Domain: stas.aimino.io

# ── Agent Provider ───────────────────────────
# OPENCODE_PROVIDER=opensymphony      # 'opensymphony' (default) or 'opencode' (legacy)
# OPENCODE_URL=http://localhost:4096   # Agent serve URL
# OPENCODE_MODEL=gpt-4o               # Model for agent provider
# FREE_TIER_MODEL=free-tier           # Model for free-tier users (via llm-governance)
# FREE_TIER_BASE_URL=http://localhost:4002  # Base URL for free-tier llm-governance proxy
# PAID_TIER_MODEL=deepseek-v4-flash   # Model for paid-tier users
# PAID_TIER_BASE_URL=http://localhost:4002  # Base URL for paid-tier llm-governance proxy

# ── OpenSymphony API (opensymphony provider) ──
# OS_API_URL=http://opensymphony:4000
# OS_API_KEY=

# ── OpenSymphony Dispatch (Node.js dispatcher) ──
# Used by dispatchToOpenSymphony() in osDispatch.ts for HTTP fallback
OPEN_SYMPHONY_DISPATCH_URL=http://symphony-orchestrator:4001/api/v1/events/github
OPEN_SYMPHONY_API_KEY=
OPEN_SYMPHONY_TENANT=default

# n8n webhook URL for Stripe billing events (AIM-3340)
N8N_STRIPE_WEBHOOK_URL=


# ── n8n Onboarding Email Webhook ─────────────────
# This is the n8n webhook URL for sending welcome + credits emails
# when a tenant completes the onboarding wizard.
N8N_ONBOARDING_WEBHOOK_URL=

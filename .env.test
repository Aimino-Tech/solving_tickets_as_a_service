# E2E Test Environment
# This file is loaded by dotenv during E2E tests.
# Provides minimal required config so the app starts.

NODE_ENV=test
TEST=true
LOG_LEVEL=silent

# Required GitHub App config (test values)
GITHUB_APP_ID=999999
GITHUB_WEBHOOK_SECRET=test-secret
GITHUB_APP_PRIVATE_KEY=test-private-key

DEV_SKIP_WEBHOOK_SIGNATURE_VERIFY=true

STAS_LABEL=stas:fix

# Disable all external integrations
SLACK_WEBHOOK_URL=
E2B_API_KEY=
LINEAR_API_KEY=
JIRA_URL=
STRIPE_SECRET_KEY=
ADMIN_API_KEY=test-admin-key
IP_ALLOWLIST_ENABLED=false
OPENAI_API_KEY=sk-test-placeholder

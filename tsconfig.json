{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "src/__tests__/**",
    "dashboard/**",
    "plugin/**",
    "premium/**",
    "website/**",
    "eval/**",
    "tests/**",
    "public/**",
    "data/**"
  ]
}

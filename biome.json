{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "files": {
    "includes": ["**", "!**/node_modules", "!**/dist", "!**/build", "!**/plugin"]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "includes": ["**/__tests__/**", "*.test.ts"],
      "plugins": ["vitest"],
      "vitest": {
        "no-standalone-expect": "error",
        "valid-expect": "error",
        "prefer-to-be": "error",
        "no-conditional-expect": "error",
        "no-conditional-in-test": "error",
        "no-import-node-test": "error"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useConst": "error",
        "noTodoComment": {
          "level": "warn",
          "options": {
            "terms": ["TODO", "FIXME", "HACK", "XXX"]
          }
        }
      },
      "complexity": {
        "noBannedTypes": "off",
        "noForEach": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "off",
          "options": {
            "allow": ["log"]
          }
        }
      },
      "correctness": {
        "noUnusedVariables": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["src/__tests__/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}

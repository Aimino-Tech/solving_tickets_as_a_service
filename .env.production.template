# =============================================================================
# STAS — Solving Tickets As A Service
# PRODUCTION Environment Configuration
# =============================================================================
# Copy this file to .env and fill in all (REQUIRED) values:
#   cp .env.production .env
#
# WARNING: This file contains SECRETS. Never commit actual values to version
# control. Use a secrets manager (Vault, AWS Secrets Manager, Doppler, etc.)
# in production.
# =============================================================================

# === Run Mode ===
RUN_MODE=both
# Values: api | worker | both

PORT=3000
NODE_ENV=production

# === Logging (Structured JSON — consumed by Datadog/Logz.io/ELK) ===
LOG_LEVEL=info
# Values: debug | info | warn | error

# === Admin API ===
ADMIN_API_KEY=
# (REQUIRED) API key for /admin/* endpoints. Generate with: openssl rand -hex 32

# =============================================================================
# GitHub App — (REQUIRED) Create one at https://github.com/settings/apps/new
# =============================================================================
# Setup instructions:
#   1. Go to https://github.com/settings/apps/new
#   2. Set Webhook URL to https://your-domain.com/webhook
#   3. Set Webhook secret (copy to GITHUB_WEBHOOK_SECRET below)
#   4. Repository permissions: Issues (read+write), Pull Requests (write),
#      Contents (write), Metadata (read-only)
#   5. Subscribe to: Issues, Issue comments, Pull requests
#   6. Generate a private key and download the PEM file
#   7. Copy the App ID below
# =============================================================================

GITHUB_APP_ID=
# (REQUIRED) Numeric GitHub App ID from the app settings page

GITHUB_APP_PRIVATE_KEY=
# (REQUIRED) GitHub App private key (PEM content) — use a single line with \n
# OR set GITHUB_APP_PRIVATE_KEY_PATH to a mounted file path.
# Never commit the actual PEM to version control.
# Example:
#   GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpA...\n-----END RSA PRIVATE KEY-----"

# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-private-key.pem
# Alternative: path to PEM file mounted from Docker secret or volume

GITHUB_WEBHOOK_SECRET=
# (REQUIRED) Webhook secret configured in your GitHub App settings
# Used for HMAC-SHA256 signature verification of incoming webhooks

GITHUB_TOKEN=
# (Optional) Personal Access Token fallback for API calls when no
# installation ID is available. Use classic PAT with repo scope.

# === GitHub OAuth (for dashboard login) ===
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# =============================================================================
# Redis — BullMQ Job Queue Backend
# =============================================================================

REDIS_URL=redis://:password@redis-host:6379
# (REQUIRED) Redis connection string for BullMQ job queues

# === Queue Tuning ===
WORKER_CONCURRENCY=4
QUEUE_DEDUP_TTL_SECONDS=120
QUEUE_KEEP_COMPLETED=200
QUEUE_KEEP_FAILED=100
QUEUE_MAX_RETRIES=4
QUEUE_RETRY_DELAYS=30000,120000,300000,900000

# =============================================================================
# OpenCode — AI Agent Backend
# =============================================================================

OPENCODE_URL=http://opencode:4096
# (REQUIRED) URL of your OpenCode serve instance

OPENCODE_MODEL=anthropic/claude-sonnet-4-20250514
# Default model for agent runs

FALLBACK_MODELS=gpt-4o,claude-haiku
# Comma-separated fallback models if primary fails

# === API Keys ===
# OPENAI_API_KEY=sk-...
# (Optional) OpenAI API key for cheap model fallback

# E2B_API_KEY=
# (Optional) E2B sandbox API key for cloud sandbox execution

# =============================================================================
# Database — PostgreSQL
# =============================================================================

DATABASE_URL=postgres://stas:password@postgres-host:5432/stas?sslmode=require
# (REQUIRED) PostgreSQL connection string for persistent storage

DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL=true

# =============================================================================
# Monitoring & Error Tracking
# =============================================================================

SENTRY_DSN=
# (REQUIRED) Sentry DSN for error tracking. Get one at https://sentry.io
# Example: https://xxxxx@xxxxx.ingest.us.sentry.io/xxxxx

SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
# Transaction sampling rate (0.0–1.0). 0.1 = 10% of requests traced.

# === Health Check Thresholds ===
HEALTH_QUEUE_DEPTH_WARN_THRESHOLD=50
HEALTH_QUEUE_DEPTH_CRIT_THRESHOLD=200
HEALTH_QUEUE_DEPTH_ALERT_MINUTES=5

# === Dead Letter Queue ===
DLQ_RETENTION_DAYS=7

# =============================================================================
# Alerting — Slack Notifications
# =============================================================================

SLACK_WEBHOOK_URL=
# (Optional) Slack webhook URL for alert notifications
# Create one at: https://api.slack.com/messaging/webhooks

SLACK_CHANNEL=#stas-alerts
# (Optional) Default Slack channel for alerts

ALERT_SLACK_CHANNEL=#stas-alerts
ALERT_WARN_QUEUE_DEPTH=50
ALERT_CRIT_QUEUE_DEPTH=200
ALERT_WARN_ERROR_RATE_PERCENT=10
ALERT_CRIT_ERROR_RATE_PERCENT=30

# =============================================================================
# Slack Bot (for interactive messages and commands)
# =============================================================================

# SLACK_BOT_TOKEN=xoxb-...
# (Optional) Slack Bot token for sending interactive messages

# SLACK_SIGNING_SECRET=
# (Optional) Slack signing secret for verifying Slack requests

# =============================================================================
# Security
# =============================================================================

CORS_ORIGIN=*
# Allowed CORS origin(s). Comma-separated for multiple origins.
# In production, restrict to your dashboard domain.

IP_ALLOWLIST_ENABLED=false
# Enable IP allowlisting for webhook endpoints

IP_ALLOWLIST=
# Comma-separated list of allowed IPs/CIDRs for webhook endpoints
# Example: 192.30.252.0/22,185.199.108.0/22 (GitHub's webhook IPs)

# === Rate Limiting ===
STAS_RATE_LIMIT_DEFAULT_TIER=free
STAS_RATE_LIMIT_IP_MAX=30
STAS_RATE_LIMIT_WINDOW_MS=60000
STAS_RATE_LIMIT_MAX=30

# =============================================================================
# Feature Flags
# =============================================================================

FEATURE_FLAGS_DEFAULT_TTL_SECONDS=30
FEATURE_FLAGS_AUTO_DISABLE_THRESHOLD=0.05

# =============================================================================
# CI Monitoring
# =============================================================================

CI_MONITOR_ENABLED=false
CI_REPOS=
CI_POLL_INTERVAL_MS=60000
CI_FAILURE_THRESHOLD=3

# =============================================================================
# Docker Sandbox
# =============================================================================

DOCKER_IMAGE=node:20-slim
DOCKER_CONTAINER_MEMORY=4g
DOCKER_CONTAINER_CPU=2
DOCKER_NETWORK_RESTRICT=true
DOCKER_ALLOWED_HOSTS=api.github.com,github.com,raw.githubusercontent.com,registry.npmjs.org,pypi.org,files.pythonhosted.org,proxy.golang.org,index.crates.io,crates.io
DOCKER_SECCOMP_PROFILE=./docker/seccomp/sandbox.json
DOCKER_APPARMOR_PROFILE=stas-sandbox
DOCKER_GVISOR_ENABLED=false

# === Sandbox Security ===
SANDBOX_PRIVILEGED=false
SANDBOX_READONLY_ROOT=true
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_PIDS_LIMIT=256
SANDBOX_DISK_LIMIT=2gb
SANDBOX_NETWORK_ENABLED=false

# =============================================================================
# Usage Metering & Billing
# =============================================================================

STAS_DEFAULT_TIER=free
STAS_MONTHLY_QUOTA_ENABLED=true
STAS_WORKER_CONCURRENCY=4
STAS_MODE=hosted
STAS_LABEL=stas:fix

# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# (Optional) Stripe keys for credit purchase billing

# =============================================================================
# Tracker Integrations (Optional)
# =============================================================================

# LINEAR_API_KEY=
# LINEAR_WEBHOOK_SECRET=

# JIRA_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_WEBHOOK_SECRET=
# JIRA_PROJECT_KEY=

# GITLAB_URL=https://gitlab.com
# GITLAB_TOKEN=
# GITLAB_WEBHOOK_SECRET=

# BITBUCKET_USERNAME=
# BITBUCKET_APP_PASSWORD=
# BITBUCKET_WEBHOOK_SECRET=

# =============================================================================
# OpenCode Health Check
# =============================================================================

OPENCODE_HEALTH_CIRCUIT_BREAKER_THRESHOLD=3
OPENCODE_HEALTH_POLL_INTERVAL_MS=30000
OPENCODE_HEALTH_CACHE_TTL_MS=30000
OPENCODE_HEALTH_REQUEST_TIMEOUT_MS=10000
OPENCODE_HEALTH_STARTUP_TIMEOUT_MS=120000

# =============================================================================
# Data Privacy & Compliance
# =============================================================================

DPA_VERSION=2026-06-01
DPA_REQUIRE_ACCEPTANCE=true
DATA_RETENTION_DAYS=30

# =============================================================================
# Phase Timeouts
# =============================================================================

FIX_TIMEOUT_MS=600000
PHASE_TIMEOUT_TRIAGE_MS=30000
PHASE_TIMEOUT_SANDBOX_MS=600000
PHASE_TIMEOUT_PRCREATION_MS=30000

# =============================================================================
# Agent Configuration
# =============================================================================

MAX_AGENT_ITERATIONS=40
MAX_ISSUE_COMMENTS=15
BOT_NAME=STAS
DEV_SKIP_WEBHOOK_SIGNATURE_VERIFY=false
